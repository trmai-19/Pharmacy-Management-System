<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx/21" 
            prefHeight="600" prefWidth="900" 
            style="-fx-background-color: #f8f9fa; -fx-padding: 30;">

    <VBox spacing="20">
        <Label text="🔍 Tra cứu thông tin sản phẩm" 
               style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>

        <HBox spacing="10">
            <TextField promptText="Nhập tên sản phẩm hoặc mã sản phẩm..." prefWidth="500"/>
            <Button text="Tìm kiếm" style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-padding: 10 20;"/>
        </HBox>

        <Label text="Kết quả tìm kiếm sẽ hiển thị ở đây..." 
               style="-fx-font-size: 16px; -fx-text-fill: #7f8c8d;"/>
    </VBox>
</AnchorPane>
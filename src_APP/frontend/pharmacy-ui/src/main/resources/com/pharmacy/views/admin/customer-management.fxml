<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="800.0" prefWidth="1200.0" style="-fx-background-color: transparent;" xmlns="http://javafx.com/javafx/19" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.pharmacy.controller.admin.CustomerManagerController">
   <children>
      <VBox spacing="20.0" AnchorPane.bottomAnchor="20.0" AnchorPane.leftAnchor="30.0" AnchorPane.rightAnchor="30.0" AnchorPane.topAnchor="20.0">
         <children>
            
            <HBox spacing="20.0">
               <children>
                  <VBox prefWidth="250.0" style="-fx-background-color: #f8fafc; -fx-background-radius: 12; -fx-border-color: #e2e8f0; -fx-border-radius: 12; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.03), 10, 0, 0, 5); -fx-padding: 20;" HBox.hgrow="ALWAYS">
                     <children>
                        <Label style="-fx-text-fill: #64748b; -fx-font-size: 14px; -fx-font-weight: bold;" text="TỔNG SỐ KHÁCH HÀNG" />
                        <Region prefHeight="10.0" />
                        <Label fx:id="lblTotalCustomers" style="-fx-font-size: 32px; -fx-font-weight: 900; -fx-text-fill: #0f766e;" text="0" />
                     </children>
                  </VBox>
                  <VBox prefWidth="250.0" style="-fx-background-color: #E0E7FF; -fx-background-radius: 12; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 5); -fx-padding: 20;" HBox.hgrow="ALWAYS">
                     <children>
                        <Label style="-fx-text-fill: #64748b; -fx-font-size: 14px; -fx-font-weight: bold;" text="KHÁCH HÀNG KIM CƯƠNG" />
                        <Region prefHeight="10.0" />
                        <Label fx:id="lblDiamondCustomers" style="-fx-font-size: 32px; -fx-font-weight: 900; -fx-text-fill: #4338ca;" text="0" />
                     </children>
                  </VBox>
                  <VBox prefWidth="250.0" style="-fx-background-color: #FEF08A; -fx-background-radius: 12; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 5); -fx-padding: 20;" HBox.hgrow="ALWAYS">
                     <children>
                        <Label style="-fx-text-fill: #64748b; -fx-font-size: 14px; -fx-font-weight: bold;" text="KHÁCH HÀNG VÀNG" />
                        <Region prefHeight="10.0" />
                        <Label fx:id="lblGoldCustomers" style="-fx-font-size: 32px; -fx-font-weight: 900; -fx-text-fill: #a16207;" text="0" />
                     </children>
                  </VBox>
                  <VBox prefWidth="250.0" style="-fx-background-color: #E2E8F0; -fx-background-radius: 12; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 5); -fx-padding: 20;" HBox.hgrow="ALWAYS">
                     <children>
                        <Label style="-fx-text-fill: #64748b; -fx-font-size: 14px; -fx-font-weight: bold;" text="KHÁCH HÀNG BẠC" />
                        <Region prefHeight="10.0" />
                        <Label fx:id="lblSilverCustomers" style="-fx-font-size: 32px; -fx-font-weight: 900; -fx-text-fill: #475569;" text="0" />
                     </children>
                  </VBox>
               </children>
            </HBox>

            <VBox style="-fx-background-color: white; -fx-background-radius: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 5);" VBox.vgrow="ALWAYS">
               <padding><Insets bottom="20.0" left="20.0" right="20.0" top="20.0" /></padding>
               <children>
                  <HBox alignment="CENTER_LEFT" prefHeight="60.0" spacing="15.0">
                     <children>
                       <HBox alignment="CENTER_LEFT" prefHeight="40.0" prefWidth="320.0" style="-fx-background-color: #f1f5f9; -fx-background-radius: 8; -fx-padding: 0 15;">
                           <children>
                              <Label style="-fx-text-fill: #64748b; -fx-font-size: 14px;" text="🔍" />
                              <TextField fx:id="txtSearch" onAction="#handleSearchData" prefHeight="35.0" promptText="Gõ Tên/SĐT rồi ấn Enter..." style="-fx-background-color: transparent; -fx-font-size: 14px;" HBox.hgrow="ALWAYS" />
                           </children>
                        </HBox>
                        
                        <ComboBox fx:id="cbTier" onAction="#handleSearchData" prefHeight="40.0" prefWidth="201.0" promptText="Tất cả hạng mức" style="-fx-background-color: #f1f5f9; -fx-background-radius: 8; -fx-font-size: 14px;" />
                        
                        <Region HBox.hgrow="ALWAYS" />
                        
                        <Button fx:id="btnShowUpgradeForm" onAction="#handleShowUpgradeForm" prefHeight="40.0" style="-fx-background-color: #0f766e; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14px; -fx-background-radius: 8; -fx-cursor: hand;" text="+ TẠO TÀI KHOẢN" />
                        
                        <Button fx:id="btnShowCreateForm" onAction="#handleShowCreateForm" prefHeight="40.0" style="-fx-background-color: #0f766e; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14px; -fx-background-radius: 8; -fx-cursor: hand;" text="+ TẠO HỒ SƠ" />
                     </children>
                     <VBox.margin><Insets bottom="15.0" /></VBox.margin>
                  </HBox>

                  <TableView fx:id="tableCustomer" style="-fx-font-size: 14px; -fx-selection-bar: #ccfbf1; -fx-background-radius: 8;" VBox.vgrow="ALWAYS">
                    <columns>
                      <TableColumn fx:id="colId" prefWidth="100.0" style="-fx-alignment: CENTER;" text="Mã KH" />
                      <TableColumn fx:id="colName" prefWidth="180.0" style="-fx-font-weight: bold;" text="Họ và tên" />
                      <TableColumn fx:id="colPhone" prefWidth="120.0" style="-fx-alignment: CENTER;" text="Số điện thoại" />
                      <TableColumn fx:id="colDob" prefWidth="110.0" style="-fx-alignment: CENTER;" text="Ngày Sinh" />
                      <TableColumn fx:id="colTier" prefWidth="100.0" style="-fx-alignment: CENTER;" text="Hạng" />
                      <TableColumn fx:id="colPoints" prefWidth="90.0" style="-fx-alignment: CENTER-RIGHT;" text="Điểm TL" />
                      <TableColumn fx:id="colTotalSpent" prefWidth="120.0" style="-fx-alignment: CENTER-RIGHT; -fx-text-fill: #0f766e; -fx-font-weight: bold;" text="Tổng chi tiêu" />
                      <TableColumn fx:id="colActionView" prefWidth="100.0" style="-fx-alignment: CENTER;" text="Lịch Sử" />
                    </columns>
                     <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY" /></columnResizePolicy>
                  </TableView>
               </children>
            </VBox>
         </children>
      </VBox>

      <StackPane fx:id="modalOverlay" alignment="CENTER" visible="false" style="-fx-background-color: rgba(0, 0, 0, 0.4);" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <children>
            <VBox StackPane.alignment="CENTER" maxHeight="-Infinity" maxWidth="-Infinity" prefWidth="550.0" style="-fx-background-color: #f8fafc; -fx-background-radius: 12; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.2), 20, 0, 0, 10);">
               <children>
                  <VBox alignment="CENTER" spacing="5.0" style="-fx-background-color: white; -fx-background-radius: 12 12 0 0; -fx-padding: 25; -fx-border-color: transparent transparent #e2e8f0 transparent; -fx-border-width: 0 0 1 0;">
                     <children>
                        <Label style="-fx-font-size: 24px; -fx-font-weight: 900; -fx-text-fill: #0f766e;" text="TẠO HỒ SƠ KHÁCH HÀNG" />
                        <Label style="-fx-text-fill: #64748b; -fx-font-size: 14px;" text="Tạo hồ sơ cho khách hàng mới" />
                     </children>
                  </VBox>
                  <VBox spacing="20.0" style="-fx-background-color: white; -fx-padding: 30;">
                     <children>
                        <VBox spacing="8.0">
                           <children>
                              <Label style="-fx-font-weight: bold; -fx-text-fill: #334155; -fx-font-size: 14px;" text="Họ và tên (*)" />
                              <TextField fx:id="txtNewName" prefHeight="45.0" promptText="Nhập họ và tên..." style="-fx-background-color: white; -fx-border-color: #cbd5e1; -fx-border-radius: 6; -fx-background-radius: 6; -fx-font-size: 14px;" />
                           </children>
                        </VBox>
                        <VBox spacing="8.0">
                           <children>
                              <Label style="-fx-font-weight: bold; -fx-text-fill: #334155; -fx-font-size: 14px;" text="Số điện thoại (*)" />
                              <TextField fx:id="txtNewPhone" prefHeight="45.0" promptText="Nhập số điện thoại..." style="-fx-background-color: white; -fx-border-color: #cbd5e1; -fx-border-radius: 6; -fx-background-radius: 6; -fx-font-size: 14px;" />
                           </children>
                        </VBox>
                        <HBox spacing="20.0">
                           <children>
                              <VBox spacing="8.0" HBox.hgrow="ALWAYS">
                                 <children>
                                    <Label style="-fx-font-weight: bold; -fx-text-fill: #334155; -fx-font-size: 14px;" text="Giới tính (*)" />
                                    <ComboBox fx:id="cbNewGender" maxWidth="1.7976931348623157E308" prefHeight="45.0" promptText="-- Chọn giới tính --" style="-fx-background-color: white; -fx-border-color: #cbd5e1; -fx-border-radius: 6; -fx-background-radius: 6; -fx-font-size: 14px;" />
                                 </children>
                              </VBox>
                              <VBox spacing="8.0" HBox.hgrow="ALWAYS">
                                 <children>
                                    <Label style="-fx-font-weight: bold; -fx-text-fill: #334155; -fx-font-size: 14px;" text="Ngày sinh (*)" />
                                    <DatePicker fx:id="dpNewDOB" maxWidth="1.7976931348623157E308" prefHeight="45.0" promptText="dd/MM/yyyy" style="-fx-background-color: white; -fx-border-color: #cbd5e1; -fx-border-radius: 6; -fx-background-radius: 6; -fx-font-size: 14px;" />
                                 </children>
                              </VBox>
                           </children>
                        </HBox>
                     </children>
                  </VBox>
                  <HBox alignment="CENTER_RIGHT" spacing="15.0" style="-fx-background-color: white; -fx-padding: 20 30 30 30; -fx-background-radius: 0 0 12 12;">
                     <children>
                        <Button mnemonicParsing="false" onAction="#handleCloseCreateForm" prefHeight="40.0" prefWidth="120.0" style="-fx-background-color: white; -fx-border-color: #cbd5e1; -fx-border-radius: 6; -fx-text-fill: #475569; -fx-font-weight: bold; -fx-cursor: hand;" text="HỦY BỎ" />
                        <Button mnemonicParsing="false" onAction="#handleSaveCustomer" prefHeight="40.0" prefWidth="160.0" style="-fx-background-color: #0f766e; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand;" text="TẠO HỒ SƠ" />
                     </children>
                  </HBox>
               </children>
            </VBox>
         </children>
      </StackPane>
      
      <StackPane fx:id="modalInvoiceHistory" alignment="CENTER" visible="false" style="-fx-background-color: rgba(0, 0, 0, 0.4);" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <children>
            <VBox StackPane.alignment="CENTER" maxHeight="-Infinity" maxWidth="-Infinity" prefWidth="900.0" prefHeight="650.0" spacing="15.0" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 25; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.3), 20, 0, 0, 10);">
                <HBox alignment="CENTER_LEFT">
                     <Label fx:id="lblHistoryCustomerName" text="📋 Lịch Sử Mua Hàng: ..." textFill="#09736a" style="-fx-font-size: 20px; -fx-font-weight: 900;"/>
                     <Region HBox.hgrow="ALWAYS"/>
                     <Button text="✕" onAction="#handleCloseHistory" style="-fx-background-color: transparent; -fx-cursor: hand; -fx-font-size: 18px; -fx-text-fill: #64748b;"/>
                </HBox>
                
                <Label text="Nhấp vào một hóa đơn để xem chi tiết bên dưới:" style="-fx-font-style: italic; -fx-text-fill: #64748b;"/>
                
                <TableView fx:id="tableInvoiceHistory" prefHeight="220.0" style="-fx-border-color: #e2e8f0; -fx-border-radius: 5;">
                    <columns>
                        <TableColumn fx:id="colInvId" prefWidth="120.0" text="Mã HĐ"/>
                        <TableColumn fx:id="colInvDate" prefWidth="150.0" text="Ngày Bán"/>
                        <TableColumn fx:id="colInvTotal" prefWidth="130.0" style="-fx-alignment: CENTER_RIGHT;" text="Tổng Tiền"/>
                        <TableColumn fx:id="colInvPoints" prefWidth="100.0" style="-fx-alignment: CENTER;" text="Điểm SD"/>
                        <TableColumn fx:id="colInvAmount" prefWidth="130.0" style="-fx-alignment: CENTER_RIGHT; -fx-font-weight: bold; -fx-text-fill: #dc2626;" text="Thanh Toán"/>
                        <TableColumn fx:id="colInvStatus" prefWidth="100.0" style="-fx-alignment: CENTER;" text="Trạng Thái"/>
                    </columns>
                    <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                </TableView>
                
                <Label text="Chi tiết sản phẩm của hóa đơn được chọn:" style="-fx-font-weight: bold; -fx-text-fill: #334155;"/>
                
                <TableView fx:id="tableInvoiceDetails" prefHeight="200.0" style="-fx-border-color: #e2e8f0; -fx-border-radius: 5; -fx-background-color: #f8fafc;">
                    <columns>
                        <TableColumn fx:id="colDetailMasp" prefWidth="250.0" text="Sản Phẩm"/>
                        <TableColumn fx:id="colDetailMalo" prefWidth="120.0" style="-fx-alignment: CENTER;" text="Mã Lô"/>
                        <TableColumn fx:id="colDetailSl" prefWidth="80.0" style="-fx-alignment: CENTER;" text="SL"/>
                        <TableColumn fx:id="colDetailPrice" prefWidth="120.0" style="-fx-alignment: CENTER_RIGHT;" text="Đơn Giá"/>
                        <TableColumn fx:id="colDetailTotal" prefWidth="130.0" style="-fx-alignment: CENTER_RIGHT;" text="Thành Tiền"/>
                    </columns>
                    <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                </TableView>
                
                <HBox alignment="CENTER_RIGHT" style="-fx-padding: 10 0 0 0;">
                     <Button text="ĐÓNG" onAction="#handleCloseHistory" prefHeight="40.0" prefWidth="120.0" style="-fx-background-color: white; -fx-border-color: #cbd5e1; -fx-border-radius: 6; -fx-text-fill: #475569; -fx-font-weight: bold; -fx-cursor: hand;"/>
                </HBox>
            </VBox>
         </children>
      </StackPane>

      <StackPane fx:id="modalUpgradeAccount" alignment="CENTER" visible="false" style="-fx-background-color: rgba(0, 0, 0, 0.4);" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <children>
            <VBox StackPane.alignment="CENTER" maxHeight="-Infinity" maxWidth="-Infinity" prefWidth="550.0" style="-fx-background-color: #f8fafc; -fx-background-radius: 12; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.2), 20, 0, 0, 10);">
               <children>
                  <VBox alignment="CENTER" spacing="5.0" style="-fx-background-color: white; -fx-background-radius: 12 12 0 0; -fx-padding: 25; -fx-border-color: transparent transparent #e2e8f0 transparent; -fx-border-width: 0 0 1 0;">
                     <children>
                        <Label style="-fx-font-size: 24px; -fx-font-weight: 900; -fx-text-fill: #0f766e;" text="TẠO TÀI KHOẢN KHÁCH HÀNG" />
                        <Label style="-fx-text-fill: #64748b; -fx-font-size: 14px;" text="Cấp tài khoản đăng nhập cho khách hàng" />
                     </children>
                  </VBox>
                  <VBox spacing="20.0" style="-fx-background-color: white; -fx-padding: 30;">
                     <children>
                        <VBox spacing="8.0">
                           <children>
                              <Label style="-fx-font-weight: bold; -fx-text-fill: #334155; -fx-font-size: 14px;" text="Mã Khách Hàng" />
                              <TextField fx:id="txtUpgradeMaKH" disable="true" prefHeight="45.0" style="-fx-background-color: #f1f5f9; -fx-border-color: #cbd5e1; -fx-border-radius: 6; -fx-background-radius: 6; -fx-font-size: 14px; -fx-opacity: 1;" />
                           </children>
                        </VBox>
                        <VBox spacing="8.0">
                           <children>
                              <Label style="-fx-font-weight: bold; -fx-text-fill: #334155; -fx-font-size: 14px;" text="Email nhận thông tin (*)" />
                              <TextField fx:id="txtUpgradeEmail" prefHeight="45.0" promptText="Nhập email của khách hàng..." style="-fx-background-color: white; -fx-border-color: #cbd5e1; -fx-border-radius: 6; -fx-background-radius: 6; -fx-font-size: 14px;" />
                           </children>
                        </VBox>
                     </children>
                  </VBox>
                  <HBox alignment="CENTER_RIGHT" spacing="15.0" style="-fx-background-color: white; -fx-padding: 20 30 30 30; -fx-background-radius: 0 0 12 12;">
                     <children>
                        <Button mnemonicParsing="false" onAction="#handleCloseUpgradeForm" prefHeight="40.0" prefWidth="120.0" style="-fx-background-color: white; -fx-border-color: #cbd5e1; -fx-border-radius: 6; -fx-text-fill: #475569; -fx-font-weight: bold; -fx-cursor: hand;" text="HỦY BỎ" />
                        <Button fx:id="btnConfirmUpgrade" mnemonicParsing="false" onAction="#handleConfirmUpgrade" prefHeight="40.0" prefWidth="160.0" style="-fx-background-color: #0f766e; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand;" text="XÁC NHẬN" />
                     </children>
                  </HBox>
               </children>
            </VBox>
         </children>
      </StackPane>
   </children>
</AnchorPane>
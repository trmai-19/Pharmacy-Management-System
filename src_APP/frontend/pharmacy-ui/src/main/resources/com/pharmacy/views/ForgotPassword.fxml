<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<StackPane fx:id="rootPane" focusTraversable="true" prefHeight="700.0" prefWidth="1150.0" style="-fx-background-color: linear-gradient(to bottom right, #0b5d77, #0f766e);" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.pharmacy.controller.common.ForgotPassController">
    
    <VBox alignment="CENTER" maxHeight="480.0" maxWidth="450.0" spacing="20.0" style="-fx-background-color: white; -fx-background-radius: 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.25), 25, 0, 0, 10);">
        <padding>
            <Insets bottom="40.0" left="40.0" right="40.0" top="40.0" />
        </padding>
        <children>
            
            <StackPane>
                <Circle fill="#ccfbf1" radius="35.0" />
                <Label style="-fx-font-size: 35px;" text="🔒" />
            </StackPane>
            
            <Region prefHeight="5.0" />
            
            <Label style="-fx-font-size: 28px; -fx-font-weight: 900; -fx-text-fill: #0f766e;" text="QUÊN MẬT KHẨU" />
            
            <Label alignment="CENTER" style="-fx-text-fill: #64748b; -fx-font-size: 15px; -fx-line-spacing: 5px;" text="Nhập thông tin để tiếp tục" textAlignment="CENTER" wrapText="true" />
            
            <Region prefHeight="10.0" />
            
            <VBox maxWidth="Infinity" spacing="8.0">
                <Label style="-fx-text-fill: #334155; -fx-font-weight: bold; -fx-font-size: 14px;" text="Tên đăng nhập / Email xác thực" />
                <HBox alignment="CENTER_LEFT" style="-fx-background-color: #f1f5f9; -fx-background-radius: 10; -fx-border-color: #e2e8f0; -fx-border-radius: 10; -fx-padding: 0 15;">
                    <Label style="-fx-text-fill: #94a3b8; -fx-font-size: 16px;" text="👤" />
                    <TextField fx:id="txtEmailOrUser" promptText="Nhập số điện thoại đăng nhập" style="-fx-background-color: transparent; -fx-padding: 12 10; -fx-font-size: 15px;" HBox.hgrow="ALWAYS" />
                </HBox>
            <HBox alignment="CENTER_LEFT" layoutX="10.0" layoutY="38.0" style="-fx-background-color: #f1f5f9; -fx-background-radius: 10; -fx-border-color: #e2e8f0; -fx-border-radius: 10; -fx-padding: 0 15;">
               <children>
                  <Label style="-fx-text-fill: #94a3b8; -fx-font-size: 16px;" text="👤" />
                  <TextField fx:id="txtEmailOrUser1" promptText="Nhập email khôi phục tài khoản" style="-fx-background-color: transparent; -fx-padding: 12 10; -fx-font-size: 15px;" HBox.hgrow="ALWAYS" />
               </children>
            </HBox>
            </VBox>
            
            <Region prefHeight="10.0" />
            
            <Button maxWidth="Infinity" onAction="#handleRequestAdmin" style="-fx-background-color: #0f766e; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 16px; -fx-background-radius: 10; -fx-padding: 12; -fx-cursor: hand; -fx-effect: dropshadow(three-pass-box, rgba(15,118,110,0.4), 15, 0, 0, 5);" text="Gửi yêu cầu tới Admin" />
            
            <Region prefHeight="5.0" />

            <HBox alignment="CENTER" spacing="5.0">
                <Hyperlink onAction="#handleGoToLogin" style="-fx-text-fill: #0ea5e9; -fx-font-weight: bold; -fx-font-size: 14px; -fx-underline: false; -fx-padding: 0;" text="Đăng nhập ngay" />
            </HBox>
            
        </children>
    </VBox>
</StackPane>

<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="750.0" prefWidth="1150.0" style="-fx-background-color: transparent;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.pharmacy.controller.warehouse.ChangePassController">
    <children>
        <VBox alignment="CENTER" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <children>
                
                <VBox maxWidth="550.0" spacing="25.0" style="-fx-background-color: white; -fx-background-radius: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.06), 20, 0, 0, 5); -fx-padding: 50;">
                    <children>
                        
                        <HBox alignment="CENTER_LEFT" spacing="15.0">
                            <StackPane>
                                <Label style="-fx-font-size: 24px;" />
                            </StackPane>
                            <VBox>
                                <Label style="-fx-text-fill: #64748b; -fx-font-size: 13px;" />
                            </VBox>
                        </HBox>
                          <Label prefHeight="79.0" prefWidth="446.0" style="-fx-font-size: 30px; -fx-font-weight: 900; -fx-text-fill: #1e293b;" text="              ĐỔI MẬT KHẨU " />
                        
                        <Region prefHeight="10.0" />

                        <VBox spacing="8.0">
                            <Label style="-fx-text-fill: #334155; -fx-font-weight: bold;" text="Mật khẩu hiện tại" />
                            <PasswordField fx:id="txtOldPass" promptText="Nhập mật khẩu hiện tại..." style="-fx-background-color: #f8fafc; -fx-border-color: #cbd5e1; -fx-border-radius: 8; -fx-padding: 12; -fx-font-size: 14px;" />
                        </VBox>

                        <VBox spacing="8.0">
                            <Label style="-fx-text-fill: #0f766e; -fx-font-weight: bold;" text="Mật khẩu mới" />
                            <PasswordField fx:id="txtNewPass" promptText="Nhập mật khẩu mới..." style="-fx-background-color: #f0fdfa; -fx-border-color: #5eead4; -fx-border-radius: 8; -fx-padding: 12; -fx-font-size: 14px;" />
                        </VBox>

                        <VBox spacing="8.0">
                            <Label style="-fx-text-fill: #0f766e; -fx-font-weight: bold;" text="Xác nhận mật khẩu mới" />
                            <PasswordField fx:id="txtConfirmPass" promptText="Nhập lại mật khẩu mới..." style="-fx-background-color: #f0fdfa; -fx-border-color: #5eead4; -fx-border-radius: 8; -fx-padding: 12; -fx-font-size: 14px;" />
                        </VBox>
                        
                        <Region prefHeight="10.0" />
                        
                        <Button maxWidth="Infinity" onAction="#handleUpdatePassword" style="-fx-background-color: #1e293b; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 14; -fx-background-radius: 8; -fx-cursor: hand; -fx-font-size: 15px;" text="🔄 CẬP NHẬT MẬT KHẨU" />
                        
                    </children>
                </VBox>

            </children>
        </VBox>
    </children>
</AnchorPane>

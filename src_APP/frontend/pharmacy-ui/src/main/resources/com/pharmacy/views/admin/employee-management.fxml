<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<AnchorPane prefHeight="850.0" prefWidth="1200.0" style="-fx-background-color: transparent;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.pharmacy.controller.admin.EmployeeManagerController">
   <children>
      <VBox spacing="25.0" AnchorPane.bottomAnchor="20.0" AnchorPane.leftAnchor="30.0" AnchorPane.rightAnchor="30.0" AnchorPane.topAnchor="20.0">
         <children>
            
            <HBox spacing="20.0">
               <children>
                  <HBox alignment="CENTER_LEFT" spacing="15.0" style="-fx-background-color: #A8DADC; -fx-background-radius: 12; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.06), 10, 0, 0, 5); -fx-padding: 20;" HBox.hgrow="ALWAYS">
                     <StackPane>
                        <Circle fill="#e0f2fe" radius="25.0" />
                        <Label style="-fx-font-size: 24px;" text="👥" />
                     </StackPane>
                     <VBox alignment="CENTER_LEFT" spacing="2.0">
                        <Label style="-fx-text-fill: #64748b; -fx-font-weight: bold; -fx-font-size: 13px;" text="TỔNG SỐ NHÂN SỰ" />
                        <Label style="-fx-text-fill: #0f766e; -fx-font-weight: 900; -fx-font-size: 22px;" text="124" />
                     </VBox>
                  </HBox>

                  <HBox alignment="CENTER_LEFT" spacing="15.0" style="-fx-background-color: #F8C9C9; -fx-background-radius: 12; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.06), 10, 0, 0, 5); -fx-padding: 20;" HBox.hgrow="ALWAYS">
                     <StackPane>
                        <Circle fill="#d1fae5" radius="25.0" />
                        <Label style="-fx-font-size: 24px;" text="👥" />
                     </StackPane>
                     <VBox alignment="CENTER_LEFT" spacing="2.0">
                        <Label style="-fx-text-fill: #64748b; -fx-font-weight: bold; -fx-font-size: 13px;" text="ĐANG LÀM VIỆC" />
                        <Label style="-fx-text-fill: #10b981; -fx-font-weight: 900; -fx-font-size: 22px;" text="118" />
                     </VBox>
                  </HBox>

                  <HBox alignment="CENTER_LEFT" spacing="15.0" style="-fx-background-color: #FDE9B5; -fx-background-radius: 12; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.06), 10, 0, 0, 5); -fx-padding: 20;" HBox.hgrow="ALWAYS">
                     <StackPane>
                        <Circle fill="#fef08a" radius="25.0" />
                        <Label style="-fx-font-size: 24px;" text="👥" />
                     </StackPane>
                     <VBox alignment="CENTER_LEFT" spacing="2.0">
                        <Label style="-fx-text-fill: #64748b; -fx-font-weight: bold; -fx-font-size: 13px;" text="NGHỈ VIỆC" />
                        <Label style="-fx-text-fill: #ca8a04; -fx-font-weight: 900; -fx-font-size: 22px;" text="45" />
                     </VBox>
                  </HBox>
               </children>
            </HBox>

            <VBox spacing="20.0" style="-fx-background-color: white; -fx-background-radius: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.08), 15, 0, 0, 5);" VBox.vgrow="ALWAYS">
               <padding>
                  <Insets bottom="25.0" left="25.0" right="25.0" top="25.0" />
               </padding>
               <children>
                  <HBox alignment="CENTER_LEFT" prefHeight="50.0" spacing="15.0">
                     <children>
                        <Label style="-fx-font-size: 20px; -fx-font-weight: 900; -fx-text-fill: #1e293b;" text="DANH SÁCH NHÂN SỰ" />
                        <Region HBox.hgrow="ALWAYS" />
                        
                        <HBox alignment="CENTER_LEFT" prefHeight="42.0" prefWidth="300.0" style="-fx-background-color: #f8fafc; -fx-background-radius: 8; -fx-border-color: #e2e8f0; -fx-border-radius: 8; -fx-padding: 0 12;">
                           <children>
                              <Label style="-fx-text-fill: #94a3b8; -fx-font-size: 14px;" text="🔍" />
                              <TextField fx:id="txtSearch" promptText="Tìm tên, mã nhân viên..." style="-fx-background-color: transparent; -fx-font-size: 14px;" HBox.hgrow="ALWAYS" />
                           </children>
                        </HBox>
                        
                        <Button fx:id="btnAdd" onAction="#openAddEmployeeForm" prefHeight="47.0" prefWidth="161.0" style="-fx-background-color: #0f766e; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand; -fx-padding: 0 20;" text="➕ THÊM NHÂN VIÊN" />
                     </children>
                  </HBox>

                  <TableView fx:id="tableEmployee" style="-fx-font-size: 14px; -fx-selection-bar: #ccfbf1; -fx-background-radius: 8;" VBox.vgrow="ALWAYS">
                    <columns>
                      <TableColumn fx:id="colId" prefWidth="100.0" style="-fx-alignment: CENTER;" text="Mã NV" />
                      <TableColumn fx:id="colName" prefWidth="250.0" text="Họ và Tên" />
                      <TableColumn fx:id="colPosition" prefWidth="150.0" style="-fx-alignment: CENTER;" text="Chức Vụ" />
                      <TableColumn fx:id="colPhone" prefWidth="150.0" style="-fx-alignment: CENTER;" text="Số Điện Thoại" />
                      <TableColumn fx:id="colStatus" prefWidth="150.0" style="-fx-alignment: CENTER;" text="Trạng Thái" />
                    </columns>
                     <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                     </columnResizePolicy>
                  </TableView>
               </children>
            </VBox>
         </children>
      </VBox>
   </children>
</AnchorPane>

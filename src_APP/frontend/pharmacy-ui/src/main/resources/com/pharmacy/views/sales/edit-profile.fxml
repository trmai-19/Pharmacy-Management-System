<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<!-- SỬA TẠI ĐÂY: Trỏ về đúng controller của warehouse -->

<AnchorPane prefHeight="800.0" prefWidth="1150.0" style="-fx-background-color: transparent;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.pharmacy.controller.sales.EditProfileController">
    <children>
        <VBox alignment="CENTER" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <children>
                <HBox alignment="CENTER" maxWidth="950.0" spacing="30.0">
                    <children>
                        
                        <VBox alignment="CENTER" prefWidth="320.0" spacing="15.0" style="-fx-background-color: white; -fx-background-radius: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.06), 15, 0, 0, 5); -fx-padding: 40 20;">
                            <children>
                                <StackPane><Circle fill="#ccfbf1" radius="60.0" /><Label style="-fx-font-size: 55px;" text="📦" /></StackPane>
                                <Label fx:id="lblFullNameCard" style="-fx-font-size: 22px; -fx-font-weight: 900; -fx-text-fill: #0f766e;" text="Nguyễn Văn Phát" />
                                <!-- SỬA TẠI ĐÂY: Hiển thị đúng vai trò -->
                                <Label style="-fx-background-color: #f1f5f9; -fx-text-fill: #64748b; -fx-font-weight: bold; -fx-padding: 5 15; -fx-background-radius: 20;" text="Nhân viên bán hàng" />
                                <Region prefHeight="15.0" />
                            </children>
                        </VBox>

                        <VBox prefWidth="550.0" spacing="15.0" style="-fx-background-color: white; -fx-background-radius: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.06), 15, 0, 0, 5); -fx-padding: 30 40;">
                            <children>
                                <Label style="-fx-font-size: 20px; -fx-font-weight: 800; -fx-text-fill: #1e293b;" text="Cập Nhật Hồ Sơ" />
                                
                                <VBox spacing="15.0">
                                    <VBox spacing="5.0">
                                        <Label style="-fx-text-fill: #64748b; -fx-font-weight: bold;" text="Họ và Tên (*)" />
                                        <TextField fx:id="txtName" style="-fx-background-color: #ffffff; -fx-border-color: #94a3b8; -fx-border-radius: 8; -fx-padding: 10;" />
                                    </VBox>

                                    <HBox spacing="20.0">
                                        <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                                            <Label style="-fx-text-fill: #64748b; -fx-font-weight: bold;" text="Giới tính" />
                                            <ComboBox fx:id="cbGender" maxWidth="Infinity" prefHeight="38.0" style="-fx-background-color: #ffffff; -fx-border-color: #94a3b8; -fx-border-radius: 8;" />
                                        </VBox>
                                        <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                                            <Label style="-fx-text-fill: #64748b; -fx-font-weight: bold;" text="Ngày sinh" />
                                            <DatePicker fx:id="dpBirthDate" maxWidth="Infinity" prefHeight="38.0" style="-fx-background-color: #ffffff; -fx-border-color: #94a3b8; -fx-border-radius: 8;" />
                                        </VBox>
                                    </HBox>

                                    <VBox spacing="5.0">
                                        <Label style="-fx-text-fill: #64748b; -fx-font-weight: bold;" text="Số Điện Thoại" />
                                        <TextField fx:id="txtPhone" style="-fx-background-color: #ffffff; -fx-border-color: #94a3b8; -fx-border-radius: 8; -fx-padding: 10;" />
                                    </VBox>

                                    <VBox spacing="5.0">
                                        <Label style="-fx-text-fill: #64748b; -fx-font-weight: bold;" text="Email" />
                                        <TextField fx:id="txtEmail" style="-fx-background-color: #ffffff; -fx-border-color: #94a3b8; -fx-border-radius: 8; -fx-padding: 10;" />
                                    </VBox>
                                    
                                    <HBox spacing="20.0">
                                        <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                                            <Label style="-fx-text-fill: #64748b; -fx-font-weight: bold;" text="Quyền hạn hệ thống" />
                                            <TextField fx:id="txtRole" editable="false" style="-fx-background-color: #f1f5f9; -fx-border-color: #e2e8f0; -fx-border-radius: 8; -fx-padding: 10;" />
                                        </VBox>
                                        <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                                            <Label style="-fx-text-fill: #64748b; -fx-font-weight: bold;" text="Ngày tham gia" />
                                            <TextField fx:id="txtJoinDate" editable="false" style="-fx-background-color: #f1f5f9; -fx-border-color: #e2e8f0; -fx-border-radius: 8; -fx-padding: 10;" />
                                        </VBox>
                                    </HBox>
                                </VBox>

                                <Region prefHeight="10.0" />
                                <HBox alignment="CENTER_RIGHT" spacing="15.0">
                                    <Button onAction="#cancelEdit" style="-fx-background-color: #f1f5f9; -fx-text-fill: #475569; -fx-font-weight: bold; -fx-padding: 12 25; -fx-background-radius: 8; -fx-cursor: hand;" text="HỦY BỎ" />
                                    <Button onAction="#handleUpdateInfo" style="-fx-background-color: #0f766e; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 12 30; -fx-background-radius: 8; -fx-cursor: hand;" text="✅ LƯU THAY ĐỔI" />
                                </HBox>
                            </children>
                        </VBox>
                    </children>
                </HBox>
            </children>
        </VBox>
    </children>
</AnchorPane>

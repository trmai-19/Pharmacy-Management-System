<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="800.0" prefWidth="1200.0" style="-fx-background-color: transparent;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.pharmacy.controller.admin.RoleManagerController">

   <children>
      <VBox spacing="20.0" AnchorPane.bottomAnchor="20.0" AnchorPane.leftAnchor="30.0" AnchorPane.rightAnchor="30.0" AnchorPane.topAnchor="30.0">

         <HBox alignment="CENTER_LEFT">
             <Label text="QUẢN LÝ QUYỀN &amp; BẢO MẬT" style="-fx-font-size: 24px; -fx-font-weight: 900; -fx-text-fill: #09736a;"/>
             <Region HBox.hgrow="ALWAYS" />
             <Label text="Cấp phát đặc quyền hệ thống cho từng nhân sự" style="-fx-font-size: 14px; -fx-text-fill: #64748b;"/>
         </HBox>

         <SplitPane dividerPositions="0.4" style="-fx-background-color: transparent; -fx-padding: 0;" VBox.vgrow="ALWAYS">
            <items>

               <VBox minWidth="380.0" prefWidth="450.0" spacing="15.0" style="-fx-background-color: white; -fx-background-radius: 12; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 5); -fx-padding: 20;">
                  <children>
                     <Label style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #1e293b;" text="DANH SÁCH NHÂN SỰ HỆ THỐNG" />

                     <TableView fx:id="tableRoles" style="-fx-font-size: 14px; -fx-selection-bar: #0ea5e9; -fx-selection-bar-text: white;" VBox.vgrow="ALWAYS">
                        <columns>
                           <TableColumn fx:id="colEmpId" prefWidth="90.0" style="-fx-alignment: CENTER;" text="Mã NV" />
                           <TableColumn fx:id="colEmpName" prefWidth="200.0" style="-fx-font-weight: bold;" text="Họ và tên" />
                           <TableColumn fx:id="colRole" prefWidth="150.0" style="-fx-alignment: CENTER;" text="Quyền hạn" />
                        </columns>
                        <columnResizePolicy>
                           <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                        </columnResizePolicy>
                     </TableView>
                  </children>
               </VBox>

               <VBox minWidth="550.0" prefWidth="700.0" spacing="20.0" style="-fx-background-color: white; -fx-background-radius: 12; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 5); -fx-padding: 25;">
                  <children>

                     <HBox alignment="CENTER_LEFT" spacing="15.0" style="-fx-background-color: #f8fafc; -fx-background-radius: 10; -fx-border-color: #e2e8f0; -fx-border-radius: 10; -fx-padding: 15 20;">
                        <Label style="-fx-font-size: 40px; -fx-text-fill: #94a3b8;" text="👤" />
                        <VBox alignment="CENTER_LEFT" spacing="2.0">
                             <Label style="-fx-font-size: 13px; -fx-text-fill: #64748b;" text="Nhân sự đang thao tác" />
                             <Label fx:id="lblSelectedEmp" style="-fx-font-size: 20px; -fx-font-weight: 900; -fx-text-fill: #0f766e;" text="Chưa chọn nhân sự..." />
                        </VBox>
                     </HBox>

                     <Label style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #1e293b; -fx-padding: 10 0 0 0;" text="MA TRẬN ĐẶC QUYỀN TRUY CẬP" />

                     <VBox fx:id="paneDetail" disable="true" style="-fx-border-color: #e2e8f0; -fx-border-radius: 8; -fx-padding: 10;" VBox.vgrow="ALWAYS">
                        <children>
                           
                           <HBox alignment="CENTER_LEFT" prefHeight="50.0" style="-fx-background-color: #f1f5f9; -fx-background-radius: 6; -fx-padding: 0 20;">
                              <children>
                                 <Label style="-fx-font-weight: 900; -fx-font-size: 14px; -fx-text-fill: #475569;" text="Module Chức Năng" />
                                 <Region HBox.hgrow="ALWAYS" />
                                 <Label alignment="CENTER" prefWidth="75.0" style="-fx-font-weight: 900; -fx-text-fill: #3b82f6; -fx-font-size: 14px;" text="👁 Xem" />
                                 <Label alignment="CENTER" prefWidth="75.0" style="-fx-font-weight: 900; -fx-text-fill: #10b981; -fx-font-size: 14px;" text="➕ Thêm" />
                                 <Label alignment="CENTER" prefWidth="75.0" style="-fx-font-weight: 900; -fx-text-fill: #f59e0b; -fx-font-size: 14px;" text="✏ Sửa" />
                                 <Label alignment="CENTER" prefWidth="75.0" style="-fx-font-weight: 900; -fx-text-fill: #ef4444; -fx-font-size: 14px;" text="🗑 Xóa" />
                              </children>
                           </HBox>

                           <HBox alignment="CENTER_LEFT" prefHeight="60.0" style="-fx-border-color: #f1f5f9; -fx-border-width: 0 0 1 0; -fx-padding: 0 20;">
                              <children>
                                 <Label style="-fx-font-weight: bold; -fx-text-fill: #334155; -fx-font-size: 14px;" text="📦 Quản lý Kho &amp; Sản phẩm" />
                                 <Region HBox.hgrow="ALWAYS" />
                                 <HBox alignment="CENTER" prefWidth="75.0"><CheckBox fx:id="chkKhoView" style="-fx-cursor: hand;"/></HBox>
                                 <HBox alignment="CENTER" prefWidth="75.0"><CheckBox fx:id="chkKhoAdd" style="-fx-cursor: hand;"/></HBox>
                                 <HBox alignment="CENTER" prefWidth="75.0"><CheckBox fx:id="chkKhoEdit" style="-fx-cursor: hand;"/></HBox>
                                 <HBox alignment="CENTER" prefWidth="75.0"><CheckBox fx:id="chkKhoDel" style="-fx-cursor: hand;"/></HBox>
                              </children>
                           </HBox>

                           <HBox alignment="CENTER_LEFT" prefHeight="60.0" style="-fx-border-color: #f1f5f9; -fx-border-width: 0 0 1 0; -fx-padding: 0 20;">
                              <children>
                                 <Label style="-fx-font-weight: bold; -fx-text-fill: #334155; -fx-font-size: 14px;" text="🛒 Đơn hàng &amp; POS Bán hàng" />
                                 <Region HBox.hgrow="ALWAYS" />
                                 <HBox alignment="CENTER" prefWidth="75.0"><CheckBox fx:id="chkSaleView" style="-fx-cursor: hand;"/></HBox>
                                 <HBox alignment="CENTER" prefWidth="75.0"><CheckBox fx:id="chkSaleAdd" style="-fx-cursor: hand;"/></HBox>
                                 <HBox alignment="CENTER" prefWidth="75.0"><CheckBox fx:id="chkSaleEdit" style="-fx-cursor: hand;"/></HBox>
                                 <HBox alignment="CENTER" prefWidth="75.0"><CheckBox fx:id="chkSaleDel" style="-fx-cursor: hand;"/></HBox>
                              </children>
                           </HBox>

                           <HBox alignment="CENTER_LEFT" prefHeight="60.0" style="-fx-padding: 0 20;">
                              <children>
                                 <Label style="-fx-font-weight: bold; -fx-text-fill: #334155; -fx-font-size: 14px;" text="👥 Quản lý Khách hàng" />
                                 <Region HBox.hgrow="ALWAYS" />
                                 <HBox alignment="CENTER" prefWidth="75.0"><CheckBox fx:id="chkCustView" style="-fx-cursor: hand;"/></HBox>
                                 <HBox alignment="CENTER" prefWidth="75.0"><CheckBox fx:id="chkCustAdd" style="-fx-cursor: hand;"/></HBox>
                                 <HBox alignment="CENTER" prefWidth="75.0"><CheckBox fx:id="chkCustEdit" style="-fx-cursor: hand;"/></HBox>
                                 <HBox alignment="CENTER" prefWidth="75.0"><CheckBox fx:id="chkCustDel" style="-fx-cursor: hand;"/></HBox>
                              </children>
                           </HBox>

                        </children>
                     </VBox>

                     <Region VBox.vgrow="ALWAYS" />

                     <HBox alignment="CENTER_RIGHT" spacing="15.0">
                        <Button fx:id="btnResetPerm" prefHeight="45.0" style="-fx-background-color: #f1f5f9; -fx-text-fill: #475569; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand; -fx-padding: 0 25;" text="⟳ Mặc định" />
                        <Button fx:id="btnSavePerm" prefHeight="45.0" style="-fx-background-color: #0f766e; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand; -fx-padding: 0 35;" text="💾 LƯU THIẾT LẬP" />
                     </HBox>
                  </children>
               </VBox>
            </items>
         </SplitPane>
      </VBox>
   </children>
</AnchorPane>
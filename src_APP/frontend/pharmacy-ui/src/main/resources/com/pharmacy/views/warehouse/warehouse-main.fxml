<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.MenuButton?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.SeparatorMenuItem?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<BorderPane prefHeight="900.0" prefWidth="1440.0" style="-fx-background-color: #f4f7f8;" stylesheets="@../../styles/admin.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.pharmacy.controller.warehouse.WarehouseController">

    <left>
        <VBox prefWidth="280.0" spacing="10" style="-fx-background-color: #0b5d77;">
            <padding>
                <Insets bottom="30" left="25" right="25" top="50" />
            </padding>
            <children>
                <HBox alignment="CENTER_LEFT" spacing="15">
                    <children>
                        <StackPane>
                            <Circle fill="WHITE" opacity="0.12" radius="36.0" />
                            <Label style="-fx-font-size: 50; -fx-effect: dropshadow(three-pass-box, #5eead4, 25, 0.3, 0, 0);" text="📦" />
                        </StackPane>
                        <VBox alignment="CENTER_LEFT">
                            <Label style="-fx-text-fill: white; -fx-font-weight: 900; -fx-font-size: 22px; -fx-letter-spacing: 1;" text="PHARMACY" />
                            <Label style="-fx-text-fill: #5eead4; -fx-font-size: 15px; -fx-font-weight: bold;" text="WAREHOUSE" />
                        </VBox>
                    </children>
                </HBox>
                
                <Region prefHeight="40" />

                <VBox fx:id="sideMenu" spacing="12">
                    <Button fx:id="btnInventory" maxWidth="Infinity" onAction="#showInventoryManager" styleClass="nav-btn, nav-btn-active" text="🏠  QUẢN LÝ KHO" />
                    <!-- THÊM NÚT QUẢN LÝ ĐỔI TRẢ Ở ĐÂY -->
                    <Button fx:id="btnReturn" maxWidth="Infinity" onAction="#showReturnManager" styleClass="nav-btn" text="↩  QUẢN LÝ ĐỔI TRẢ" />
                </VBox>

                <Region VBox.vgrow="ALWAYS" />
            </children>
        </VBox>
    </left>

    <center>
        <VBox style="-fx-background-color: #f4f7f8;">
            <children>
                <HBox alignment="CENTER_LEFT" prefHeight="100.0" spacing="20" style="-fx-background-color: rgba(13, 148, 170, 0.85);">
                    <padding>
                        <Insets left="40" right="40" />
                    </padding>
                    <VBox alignment="CENTER_LEFT" fillWidth="false">
                        <Label fx:id="lblTitle" style="-fx-font-size: 29px; -fx-font-weight: 800; -fx-text-fill: #ffffff;" text="QUẢN LÝ KHO" />
                        <HBox spacing="5">
                            <Label style="-fx-text-fill: rgba(255,255,255,0.7); -fx-font-weight: bold;" text="Warehouse" />
                        </HBox>
                    </VBox>
                    
                    <Region maxHeight="100.0" minHeight="100.0" prefHeight="100.0" HBox.hgrow="ALWAYS" />

                    <HBox alignment="CENTER_RIGHT" spacing="25.0">
                        <children>
                            <StackPane fx:id="bellIcon" focusTraversable="false" onMouseClicked="#handleShowNotifications" style="-fx-cursor: hand; -fx-background-color: transparent;">
                                <children>
                                    <Label style="-fx-font-size: 24px; -fx-text-fill: white;" text="🔔" />
                                    <AnchorPane>
                                        <children>
                                            <Label fx:id="lblNotificationCount" alignment="CENTER" layoutX="24.0" layoutY="27.0" minHeight="18.0" minWidth="18.0" style="-fx-background-color: #ef4444; -fx-background-radius: 10; -fx-text-fill: white; -fx-font-size: 11px; -fx-font-weight: bold; -fx-padding: 1 5;" text="2" />
                                        </children>
                                    </AnchorPane>
                                </children>
                            </StackPane>
                        </children>
                    </HBox>

                    <Circle fill="WHITE" radius="28.0" />
                    <AnchorPane>
                        <children>
                            <Label fx:id="lblWarehouseName" layoutY="50.0" style="-fx-font-weight: bold; -fx-text-fill: #FFFFFF; -fx-font-size: 17px;" text="Nguyễn Văn Phát" />
                            <Label layoutX="10.0" layoutY="27.0" style="-fx-font-weight: bold; -fx-text-fill: #5EEAD4; -fx-font-size: 15;" text="WAREHOUSE" />
                        </children>
                    </AnchorPane>
                         
                    <MenuButton fx:id="avatarMenuButton" style="-fx-background-color: transparent; -fx-cursor: hand; -fx-padding: 0;" styleClass="hamburger-menu" text="☰" textFill="WHITE">
                        <items>
                            <MenuItem onAction="#handleViewProfile" style="-fx-font-size: 14px; -fx-padding: 8 20 8 10;" text="📝 Thông tin tài khoản" />
                            <MenuItem onAction="#handleChangePassword" style="-fx-font-size: 14px; -fx-padding: 8 20 8 10;" text="🔑 Đổi mật khẩu" />
                            <SeparatorMenuItem />
                            <MenuItem onAction="#handleLogout" style="-fx-font-size: 14px; -fx-padding: 8 20 8 10; -fx-text-fill: #ef4444;" text="🚪 Đăng xuất" />
                        </items>
                    </MenuButton>
                </HBox>

                <!-- Vùng hiển thị nội dung -->
                <AnchorPane fx:id="contentPane" prefHeight="800.0" prefWidth="1134.0" VBox.vgrow="ALWAYS" />
                
            </children>
        </VBox>
    </center>
</BorderPane>
<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<StackPane xmlns="http://javafx.com/javafx/19" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.pharmacy.controller.sales.POSController">
    <children>
        
        <VBox spacing="20.0" style="-fx-padding: 25; -fx-background-color: #f4f7f8;">
            
            <VBox alignment="CENTER" style="-fx-background-color: #3cb4ae; -fx-background-radius: 10; -fx-padding: 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 0);">
                <HBox alignment="CENTER" maxWidth="700.0" spacing="10.0">
                    <ComboBox fx:id="cbSearchProduct" editable="true" onAction="#handleSelectProduct" prefHeight="50.0" prefWidth="600.0" promptText="🔍 Gõ tên hoặc mã sản phẩm để tìm kiếm..." styleClass="search-combo-box" HBox.hgrow="ALWAYS" />
                </HBox>
            </VBox>

            <HBox spacing="20.0" VBox.vgrow="ALWAYS">
                <VBox spacing="15.0" HBox.hgrow="ALWAYS">
                    <VBox style="-fx-background-color: white; -fx-background-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 0);" VBox.vgrow="ALWAYS">
                        <Label style="-fx-font-weight: bold; -fx-text-fill: #1e293b; -fx-padding: 15;" text="🛒 CHI TIẾT ĐƠN HÀNG">
                            <font><Font size="14.0" /></font>
                        </Label>
                        
                        <TableView fx:id="posTable" style="-fx-border-color: transparent;" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="colProductName" prefWidth="280.0" text="SẢN PHẨM" />
                                <TableColumn fx:id="colQuantity" prefWidth="100.0" style="-fx-alignment: CENTER;" text="SỐ LƯỢNG" />
                                <TableColumn fx:id="colPrice" prefWidth="130.0" style="-fx-alignment: CENTER_RIGHT;" text="ĐƠN GIÁ" />
                                <TableColumn fx:id="colTotal" prefWidth="140.0" style="-fx-alignment: CENTER_RIGHT;" text="THÀNH TIỀN" />
                                <TableColumn fx:id="colAction" prefWidth="70.0" style="-fx-alignment: CENTER;" text="XÓA" />
                            </columns>
                            <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY" /></columnResizePolicy>
                        </TableView>
                        
                        <TextArea fx:id="txtOrderNote" prefHeight="60.0" promptText="Ghi chú đơn hàng (nếu có)..." style="-fx-background-color: transparent; -fx-border-color: #e2e8f0; -fx-border-width: 1 0 0 0;" />
                    </VBox>
                </VBox>

                <VBox prefWidth="380.0" spacing="15.0">
                    <VBox spacing="20.0" style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 25; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 0);" VBox.vgrow="ALWAYS">
                        
                        <Label style="-fx-font-weight: bold; -fx-text-fill: #64748b;" text="THÔNG TIN KHÁCH HÀNG">
                            <font><Font size="13.0" /></font>
                        </Label>
                        
                        <HBox spacing="10.0">
                            <TextField fx:id="txtCustomerPhone" promptText="SĐT Khách hàng..." style="-fx-background-radius: 5; -fx-pref-height: 40;" HBox.hgrow="ALWAYS" />
                            <Button onAction="#handleSearchCustomer" style="-fx-background-color: #f1f5f9; -fx-text-fill: #09736a; -fx-font-weight: bold; -fx-background-radius: 5; -fx-pref-height: 40; -fx-cursor: hand;" text="🔍 Tìm" />
                        </HBox>

                        <VBox fx:id="boxCustomerInfo" spacing="15.0" managed="false" visible="false">
                            <Separator />
                            <VBox spacing="5.0">
                                <Label text="Tên khách hàng:" textFill="#475569" style="-fx-font-weight: bold;"/>
                                <Label fx:id="lblCustomerName" text="..." style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #09736a;"/>
                            </VBox>
                            <VBox spacing="5.0">
                                <Label text="Điểm tích lũy hiện có:" textFill="#475569" style="-fx-font-weight: bold;"/>
                                <Label fx:id="lblAvailablePoints" text="0" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #eab308;"/>
                            </VBox>
                            <VBox spacing="5.0">
                                <Label text="Nhập điểm sử dụng:" textFill="#475569" style="-fx-font-weight: bold;"/>
                                <TextField fx:id="txtPointsToUse" promptText="Ví dụ: 50..." prefHeight="40.0" style="-fx-background-radius: 5;"/>
                            </VBox>
                        </VBox>

                        <Region VBox.vgrow="ALWAYS" />
                        <Separator />
                        
                        <HBox alignment="CENTER_RIGHT" spacing="10.0">
                            <Label style="-fx-font-size: 14; -fx-font-weight: bold; -fx-text-fill: #64748b;" text="TỔNG TIỀN HÀNG:" />
                            <Label fx:id="lblCartSubtotal" style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: #1e293b;" text="0 đ" />
                        </HBox>
                        
                        <VBox spacing="10.0" style="-fx-padding: 10 0 0 0;">
                            <Button onAction="#handleCheckout" maxWidth="Infinity" style="-fx-font-size: 18; -fx-background-color: #09736a; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8; -fx-pref-height: 55; -fx-cursor: hand;" text="✅ XÁC NHẬN HÓA ĐƠN" />
                            <Button onAction="#handleClearOrder" maxWidth="Infinity" style="-fx-background-color: #fef2f2; -fx-text-fill: #dc2626; -fx-font-weight: bold; -fx-background-radius: 8; -fx-pref-height: 45; -fx-cursor: hand;" text="Hủy đơn" />
                        </VBox>

                    </VBox>
                </VBox>
            </HBox>
        </VBox>

        <StackPane fx:id="modalBatchSelection" alignment="CENTER" style="-fx-background-color: rgba(0,0,0,0.6);" visible="false">
            <VBox StackPane.alignment="CENTER" maxHeight="-Infinity" maxWidth="-Infinity" prefWidth="650.0" spacing="15.0" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 25; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.3), 20, 0, 0, 10);">
                <HBox alignment="CENTER_LEFT">
                     <Label text="📦 Chọn Lô Hàng Khả Dụng" textFill="#09736a" style="-fx-font-size: 20px; -fx-font-weight: 900;"/>
                     <Region HBox.hgrow="ALWAYS"/>
                     <Button text="✕" onAction="#handleCloseBatchSelection" style="-fx-background-color: transparent; -fx-cursor: hand; -fx-font-size: 18px; -fx-text-fill: #64748b;"/>
                </HBox>
                <Label fx:id="lblSelectProductName" text="Sản phẩm: ..." style="-fx-font-weight: bold; -fx-text-fill: #334155; -fx-font-size: 16px;"/>
                
                <TableView fx:id="tableBatchSelection" prefHeight="220.0" style="-fx-border-color: #e2e8f0; -fx-border-radius: 5;">
                    <columns>
                        <TableColumn fx:id="colBatchMalo" prefWidth="120.0" text="Mã Lô"/>
                        <TableColumn fx:id="colBatchNsx" prefWidth="100.0" style="-fx-alignment: CENTER;" text="NSX"/>
                        <TableColumn fx:id="colBatchHsd" prefWidth="100.0" style="-fx-alignment: CENTER;" text="HSD"/>
                        <TableColumn fx:id="colBatchStock" prefWidth="90.0" style="-fx-alignment: CENTER;" text="Tồn Kho"/>
                        <TableColumn fx:id="colBatchStatus" prefWidth="120.0" style="-fx-alignment: CENTER;" text="Trạng thái"/>
                    </columns>
                    <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                </TableView>
                
                <HBox alignment="CENTER_LEFT" spacing="15.0" style="-fx-padding: 10 0 0 0;">
                     <Label text="Số lượng bán: *" style="-fx-font-weight: bold; -fx-font-size: 14px;"/>
                     <TextField fx:id="txtSelectQuantity" promptText="Nhập SL..." prefHeight="40.0" prefWidth="150.0" style="-fx-font-size: 14px;"/>
                     <Region HBox.hgrow="ALWAYS"/>
                     <Button text="HỦY BỎ" onAction="#handleCloseBatchSelection" prefHeight="40.0" style="-fx-background-color: white; -fx-border-color: #cbd5e1; -fx-border-radius: 6; -fx-cursor: hand; -fx-font-weight: bold;"/>
                     <Button text="THÊM VÀO GIỎ" onAction="#handleConfirmBatchSelection" prefHeight="40.0" style="-fx-background-color: #09736a; -fx-text-fill: white; -fx-border-radius: 6; -fx-cursor: hand; -fx-font-weight: bold;"/>
                </HBox>
            </VBox>
        </StackPane>

        <StackPane fx:id="modalQuickCreate" alignment="CENTER" style="-fx-background-color: rgba(0, 0, 0, 0.4);" visible="false">
            <children>
                <VBox StackPane.alignment="CENTER" maxHeight="-Infinity" maxWidth="-Infinity" prefWidth="500.0" style="-fx-background-color: #f8fafc; -fx-background-radius: 12; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.2), 20, 0, 0, 10);">
                    <VBox alignment="CENTER" spacing="5.0" style="-fx-background-color: white; -fx-background-radius: 12 12 0 0; -fx-padding: 25; -fx-border-color: transparent transparent #e2e8f0 transparent; -fx-border-width: 0 0 1 0;">
                        <Label style="-fx-font-size: 20px; -fx-font-weight: 900; -fx-text-fill: #09736a;" text="THÊM KHÁCH HÀNG MỚI" />
                        <Label style="-fx-text-fill: #64748b; -fx-font-size: 13px;" text="Chưa có trên hệ thống. Tạo nhanh để tích điểm!" />
                    </VBox>
                    <VBox spacing="20.0" style="-fx-background-color: white; -fx-padding: 30;">
                        <VBox spacing="8.0">
                            <Label style="-fx-font-weight: bold; -fx-text-fill: #334155; -fx-font-size: 14px;" text="Số điện thoại (*)" />
                            <TextField fx:id="txtQuickCreatePhone" editable="false" disable="true" prefHeight="45.0" style="-fx-opacity: 1; -fx-background-color: #f1f5f9; -fx-border-color: #cbd5e1; -fx-border-radius: 6; -fx-background-radius: 6; -fx-font-size: 14px; -fx-font-weight: bold;" />
                        </VBox>
                        <VBox spacing="8.0">
                            <Label style="-fx-font-weight: bold; -fx-text-fill: #334155; -fx-font-size: 14px;" text="Họ và tên khách hàng (*)" />
                            <TextField fx:id="txtQuickCreateName" prefHeight="45.0" promptText="VD: Nguyễn Văn A..." style="-fx-background-color: white; -fx-border-color: #cbd5e1; -fx-border-radius: 6; -fx-background-radius: 6; -fx-font-size: 14px;" />
                        </VBox>
                        <VBox spacing="8.0">
                            <Label style="-fx-font-weight: bold; -fx-text-fill: #334155; -fx-font-size: 14px;" text="Giới tính" />
                            <ComboBox fx:id="cbQuickCreateGender" prefHeight="45.0" maxWidth="Infinity" style="-fx-background-color: white; -fx-border-color: #cbd5e1; -fx-border-radius: 6; -fx-background-radius: 6; -fx-font-size: 14px;" />
                        </VBox>
                    </VBox>
                    <HBox alignment="CENTER_RIGHT" spacing="15.0" style="-fx-background-color: white; -fx-padding: 20 30 30 30; -fx-background-radius: 0 0 12 12;">
                        <Button mnemonicParsing="false" onAction="#handleCloseQuickCreate" prefHeight="40.0" prefWidth="120.0" style="-fx-background-color: white; -fx-border-color: #cbd5e1; -fx-border-radius: 6; -fx-text-fill: #475569; -fx-font-weight: bold; -fx-cursor: hand;" text="HỦY BỎ" />
                        <Button mnemonicParsing="false" onAction="#handleSubmitQuickCreate" prefHeight="40.0" prefWidth="160.0" style="-fx-background-color: #09736a; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand;" text="LƯU &amp; TIẾP TỤC" />
                    </HBox>
                </VBox>
            </children>
        </StackPane>

        <StackPane fx:id="summaryModalOverlay" alignment="CENTER" style="-fx-background-color: rgba(0, 0, 0, 0.6);" visible="false">
            <VBox StackPane.alignment="CENTER" maxHeight="-Infinity" maxWidth="-Infinity" prefWidth="550.0" prefHeight="650.0" spacing="15.0" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 25; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.3), 20, 0, 0, 10);">
                
                <Label style="-fx-font-size: 22px; -fx-font-weight: 900; -fx-text-fill: #09736a;" text="BIÊN LAI THANH TOÁN" alignment="CENTER" maxWidth="Infinity"/>
                <Separator />
                
                <GridPane vgap="12" hgap="10">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="35"/>
                        <ColumnConstraints percentWidth="65"/>
                    </columnConstraints>
                    
                    <Label text="Mã hóa đơn:" GridPane.rowIndex="0" GridPane.columnIndex="0" style="-fx-font-weight: bold; -fx-text-fill: #475569;"/>
                    <Label fx:id="lblSumInvoiceId" GridPane.rowIndex="0" GridPane.columnIndex="1" style="-fx-font-weight: bold; -fx-text-fill: #1e293b;"/>
                    
                    <Label text="Mã nhân viên:" GridPane.rowIndex="1" GridPane.columnIndex="0" style="-fx-font-weight: bold; -fx-text-fill: #475569;"/>
                    <Label fx:id="lblSumStaffId" text="NV001" GridPane.rowIndex="1" GridPane.columnIndex="1" style="-fx-font-weight: bold; -fx-text-fill: #1e293b;"/>
                    
                    <Label text="Mã khách hàng:" GridPane.rowIndex="2" GridPane.columnIndex="0" style="-fx-font-weight: bold; -fx-text-fill: #475569;"/>
                    <Label fx:id="lblSumCustomerId" GridPane.rowIndex="2" GridPane.columnIndex="1" style="-fx-font-weight: bold; -fx-text-fill: #1e293b;"/>
                    
                    <Label text="Số điện thoại:" GridPane.rowIndex="3" GridPane.columnIndex="0" style="-fx-font-weight: bold; -fx-text-fill: #475569;"/>
                    <Label fx:id="lblSumPhone" GridPane.rowIndex="3" GridPane.columnIndex="1" style="-fx-font-weight: bold; -fx-text-fill: #1e293b;"/>
                    
                    <Label text="Ngày bán:" GridPane.rowIndex="4" GridPane.columnIndex="0" style="-fx-font-weight: bold; -fx-text-fill: #475569;"/>
                    <Label fx:id="lblSumDate" GridPane.rowIndex="4" GridPane.columnIndex="1" style="-fx-font-weight: bold; -fx-text-fill: #1e293b;"/>
                    
                    <Label text="Tổng điểm:" GridPane.rowIndex="5" GridPane.columnIndex="0" style="-fx-font-weight: bold; -fx-text-fill: #475569;"/>
                    <Label fx:id="lblSumTotalPoints" GridPane.rowIndex="5" GridPane.columnIndex="1" style="-fx-font-weight: bold; -fx-text-fill: #1e293b;"/>
                    
                    <Label text="Điểm sử dụng:" GridPane.rowIndex="6" GridPane.columnIndex="0" style="-fx-font-weight: bold; -fx-text-fill: #475569;"/>
                    <Label fx:id="lblSumPointsUsed" GridPane.rowIndex="6" GridPane.columnIndex="1" style="-fx-text-fill: #eab308; -fx-font-weight: bold;"/>
                    
                    <Label text="Tiền hàng:" GridPane.rowIndex="7" GridPane.columnIndex="0" style="-fx-font-weight: bold; -fx-text-fill: #475569;"/>
                    <Label fx:id="lblSumSubtotal" GridPane.rowIndex="7" GridPane.columnIndex="1" style="-fx-font-weight: bold; -fx-text-fill: #1e293b;"/>
                    
                    <Label text="Thành tiền:" GridPane.rowIndex="8" GridPane.columnIndex="0" style="-fx-font-weight: bold; -fx-text-fill: #475569;"/>
                    <Label fx:id="lblSumFinalAmount" GridPane.rowIndex="8" GridPane.columnIndex="1" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #dc2626;"/>
                </GridPane>
                
                <Label text="Danh sách sản phẩm:" style="-fx-font-weight: bold; -fx-padding: 10 0 0 0; -fx-text-fill: #64748b;"/>
                <ListView fx:id="listSumProducts" VBox.vgrow="ALWAYS" style="-fx-background-color: #f8fafc; -fx-border-color: #e2e8f0; -fx-border-radius: 5; -fx-background-radius: 5;"/>
                
                <HBox alignment="CENTER_RIGHT" spacing="15.0" style="-fx-padding: 15 0 0 0;">
                    <Button onAction="#handleCloseSummaryModal" prefHeight="45.0" prefWidth="120.0" style="-fx-background-color: white; -fx-border-color: #cbd5e1; -fx-border-radius: 6; -fx-text-fill: #475569; -fx-font-weight: bold; -fx-cursor: hand;" text="ĐÓNG" />
                    <Button onAction="#handlePrintInvoice" prefHeight="45.0" prefWidth="160.0" style="-fx-background-color: #09736a; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand;" text="🖨 IN HÓA ĐƠN" />
                </HBox>
            </VBox>
        </StackPane>

    </children>
</StackPane>
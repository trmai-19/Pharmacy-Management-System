<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="800.0" prefWidth="1200.0" style="-fx-background-color: transparent;" xmlns="http://javafx.com/javafx/19" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.pharmacy.controller.sales.ReturnManagerController">
   <children>
      <VBox spacing="15.0" AnchorPane.bottomAnchor="20.0" AnchorPane.leftAnchor="30.0" AnchorPane.rightAnchor="30.0" AnchorPane.topAnchor="20.0">
         
         <HBox alignment="CENTER_LEFT">
             <Label text="QUẢN LÝ ĐỔI TRẢ" style="-fx-font-size: 24px; -fx-font-weight: 900; -fx-text-fill: #09736a;"/>
             <Region HBox.hgrow="ALWAYS" />
             <Button fx:id="btnCreateReturn" disable="true" text="+ Tạo Phiếu Khách Trả" onAction="#handleShowCreateModal" prefHeight="40.0" style="-fx-background-color: #0f766e; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14px; -fx-background-radius: 8; -fx-cursor: hand;"/>
         </HBox>

         <VBox spacing="10.0" style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 5);" VBox.vgrow="ALWAYS">
             
             <HBox spacing="15.0" alignment="CENTER_LEFT">
                 <TextField fx:id="txtSearchInvoice" promptText="Tìm mã hóa đơn, SĐT khách..." prefHeight="40.0" prefWidth="350.0" style="-fx-background-color: #f1f5f9; -fx-background-radius: 6;" onAction="#fetchInvoices"/>
                 <Button text="🔍" onAction="#fetchInvoices" style="-fx-background-color: #e2e8f0; -fx-cursor: hand;"/>
             </HBox>

             <Label text="DANH SÁCH HÓA ĐƠN BÁN HÀNG (Chọn 1 hóa đơn để xem/trả hàng)" style="-fx-font-weight: bold; -fx-text-fill: #0f766e; -fx-padding: 10 0 0 0;"/>
             
             <TableView fx:id="tableInvoices" VBox.vgrow="ALWAYS" style="-fx-selection-bar: #0ea5e9; -fx-selection-bar-text: white;">
                 <columns>
                     <TableColumn fx:id="colInvId" prefWidth="120.0" style="-fx-font-weight: bold;" text="Mã HĐ"/>
                     <TableColumn fx:id="colInvDate" prefWidth="140.0" style="-fx-alignment: CENTER;" text="Ngày Bán"/>
                     <TableColumn fx:id="colInvCustomer" prefWidth="230.0" text="Khách Hàng"/>
                     <TableColumn fx:id="colInvTotal" prefWidth="140.0" style="-fx-alignment: CENTER_RIGHT; -fx-font-weight: bold;" text="Tổng Tiền"/>
                     <TableColumn fx:id="colInvPoints" prefWidth="90.0" style="-fx-alignment: CENTER;" text="Điểm SD"/>
                     <TableColumn fx:id="colInvStatus" prefWidth="110.0" style="-fx-alignment: CENTER;" text="Trạng Thái"/>
                     <TableColumn fx:id="colInvAction" prefWidth="80.0" style="-fx-alignment: CENTER;" text="Chi tiết"/>
                 </columns>
                 <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
             </TableView>

             <Label fx:id="lblReturnHistoryTitle" text="LỊCH SỬ TRẢ HÀNG CỦA HÓA ĐƠN: (Chưa chọn)" style="-fx-font-weight: bold; -fx-text-fill: #dc2626; -fx-padding: 10 0 0 0;"/>
             
             <TableView fx:id="tableReturns" prefHeight="220.0" style="-fx-background-color: #f8fafc; -fx-selection-bar: #0ea5e9; -fx-selection-bar-text: white;">
                 <columns>
                     <TableColumn fx:id="colRetId" prefWidth="120.0" style="-fx-font-weight: bold;" text="Mã Phiếu"/>
                     <TableColumn fx:id="colRetDate" prefWidth="140.0" style="-fx-alignment: CENTER;" text="Ngày Trả"/>
                     <TableColumn fx:id="colRetReason" prefWidth="250.0" text="Lý do trả"/>
                     <TableColumn fx:id="colRetTotal" prefWidth="140.0" style="-fx-alignment: CENTER_RIGHT; -fx-font-weight: bold; -fx-text-fill: #dc2626;" text="Tổng Tiền Hoàn"/>
                     <TableColumn fx:id="colRetPoints" prefWidth="100.0" style="-fx-alignment: CENTER; -fx-font-weight: bold; -fx-text-fill: #09736a;" text="Điểm Hoàn"/>
                     <TableColumn fx:id="colRetAction" prefWidth="80.0" style="-fx-alignment: CENTER;" text="Chi tiết"/>
                 </columns>
                 <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
             </TableView>
         </VBox>
      </VBox>

      <StackPane fx:id="modalInvoiceDetail" visible="false" alignment="CENTER" style="-fx-background-color: rgba(0,0,0,0.6);" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
          <VBox maxWidth="800.0" maxHeight="500.0" spacing="15.0" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 25; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.3), 20, 0, 0, 10);">
              <HBox alignment="CENTER_LEFT">
                  <Label fx:id="lblInvoiceDetailTitle" text="Chi tiết Hóa Đơn: ..." style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #09736a;"/>
                  <Region HBox.hgrow="ALWAYS"/>
                  <Button text="✕" onAction="#handleCloseInvoiceDetailModal" style="-fx-background-color: transparent; -fx-cursor: hand; -fx-font-size: 18px; -fx-text-fill: #64748b;"/>
              </HBox>
              <TableView fx:id="tableInvoiceDetails" VBox.vgrow="ALWAYS" style="-fx-selection-bar: #0ea5e9;">
                  <columns>
                      <TableColumn fx:id="colInvDetTen" prefWidth="250.0" text="Sản Phẩm"/>
                      <TableColumn fx:id="colInvDetMalo" prefWidth="120.0" style="-fx-alignment: CENTER;" text="Mã Lô"/>
                      <TableColumn fx:id="colInvDetSl" prefWidth="80.0" style="-fx-alignment: CENTER;" text="SL"/>
                      <TableColumn fx:id="colInvDetGia" prefWidth="120.0" style="-fx-alignment: CENTER_RIGHT;" text="Đơn Giá"/>
                      <TableColumn fx:id="colInvDetTong" prefWidth="150.0" style="-fx-alignment: CENTER_RIGHT; -fx-font-weight: bold;" text="Thành Tiền"/>
                  </columns>
                  <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
              </TableView>
          </VBox>
      </StackPane>

      <StackPane fx:id="modalReturnDetail" visible="false" alignment="CENTER" style="-fx-background-color: rgba(0,0,0,0.6);" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
          <VBox maxWidth="800.0" maxHeight="500.0" spacing="15.0" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 25; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.3), 20, 0, 0, 10);">
              <HBox alignment="CENTER_LEFT">
                  <Label fx:id="lblReturnDetailTitle" text="Chi tiết Phiếu Trả: ..." style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #dc2626;"/>
                  <Region HBox.hgrow="ALWAYS"/>
                  <Button text="✕" onAction="#handleCloseReturnDetailModal" style="-fx-background-color: transparent; -fx-cursor: hand; -fx-font-size: 18px; -fx-text-fill: #64748b;"/>
              </HBox>
              <TableView fx:id="tableReturnDetails" VBox.vgrow="ALWAYS" style="-fx-selection-bar: #0ea5e9;">
                  <columns>
                      <TableColumn fx:id="colRetDetTen" prefWidth="250.0" text="Sản Phẩm"/>
                      <TableColumn fx:id="colRetDetMalo" prefWidth="120.0" style="-fx-alignment: CENTER;" text="Mã Lô"/>
                      <TableColumn fx:id="colRetDetSl" prefWidth="80.0" style="-fx-alignment: CENTER;" text="SL Trả"/>
                      <TableColumn fx:id="colRetDetGia" prefWidth="120.0" style="-fx-alignment: CENTER_RIGHT;" text="Đơn Giá Hoàn"/>
                      <TableColumn fx:id="colRetDetTong" prefWidth="150.0" style="-fx-alignment: CENTER_RIGHT; -fx-font-weight: bold; -fx-text-fill: #dc2626;" text="Thành Tiền"/>
                  </columns>
                  <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
              </TableView>
          </VBox>
      </StackPane>

      <StackPane fx:id="modalCreateReturn" visible="false" alignment="CENTER" style="-fx-background-color: rgba(0,0,0,0.6);" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
          <VBox maxWidth="750.0" maxHeight="650.0" spacing="15.0" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 25; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.3), 20, 0, 0, 10);">
              <HBox alignment="CENTER_LEFT">
                  <Label text="↩ Lập Phiếu Khách Trả Hàng" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #09736a;"/>
                  <Region HBox.hgrow="ALWAYS"/>
                  <Button text="✕" onAction="#handleCloseCreateModal" style="-fx-background-color: transparent; -fx-cursor: hand; -fx-font-size: 18px; -fx-text-fill: #64748b;"/>
              </HBox>
              <Separator />

              <VBox spacing="5.0">
                  <Label text="Mã hóa đơn gốc" style="-fx-font-weight: bold; -fx-text-fill: #334155;"/>
                  <TextField fx:id="txtCreateMahd" editable="false" prefHeight="40.0" style="-fx-background-color: #f1f5f9; -fx-font-weight: bold;"/>
              </VBox>

              <VBox spacing="5.0" style="-fx-background-color: #f8fafc; -fx-padding: 15; -fx-border-color: #e2e8f0; -fx-border-radius: 5;">
                  <Label text="Chọn sản phẩm trả lại *" style="-fx-font-weight: bold; -fx-text-fill: #334155;"/>
                  <HBox spacing="10.0">
                      <ComboBox fx:id="cbInvoiceItems" promptText="-- Chọn SP từ hóa đơn --" prefHeight="40.0" prefWidth="400.0"/>
                      <TextField fx:id="txtReturnQty" promptText="SL" prefHeight="40.0" prefWidth="80.0"/>
                      <Button text="Thêm" onAction="#handleAddReturnItem" prefHeight="40.0" prefWidth="80.0" style="-fx-background-color: #e2e8f0; -fx-cursor: hand; -fx-font-weight: bold;"/>
                  </HBox>
                  
                  <TableView fx:id="tableReturnCart" prefHeight="180.0" style="-fx-margin-top: 10; -fx-selection-bar: #0ea5e9;">
                      <columns>
                          <TableColumn fx:id="colCartTen" prefWidth="250.0" text="Sản Phẩm"/>
                          <TableColumn fx:id="colCartMalo" prefWidth="100.0" style="-fx-alignment: CENTER;" text="Mã Lô"/>
                          <TableColumn fx:id="colCartSl" prefWidth="50.0" style="-fx-alignment: CENTER;" text="SL"/>
                          <TableColumn fx:id="colCartGia" prefWidth="110.0" style="-fx-alignment: CENTER_RIGHT;" text="Đơn Giá Hoàn"/>
                          <TableColumn fx:id="colCartTong" prefWidth="120.0" style="-fx-alignment: CENTER_RIGHT;" text="Thành Tiền"/>
                          <TableColumn fx:id="colCartAction" prefWidth="50.0" style="-fx-alignment: CENTER;" text="Xóa"/>
                      </columns>
                      <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                  </TableView>
              </VBox>

              <HBox spacing="20.0">
                  <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                      <Label text="Tổng tiền hoàn dự kiến (VNĐ) *" style="-fx-font-weight: bold; -fx-text-fill: #334155;"/>
                      <TextField fx:id="txtTotalRefund" editable="false" text="0 đ" prefHeight="40.0" style="-fx-font-weight: bold; -fx-text-fill: #dc2626; -fx-background-color: #fef2f2;"/>
                  </VBox>
                  <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                      <Label text="Lý do khách trả *" style="-fx-font-weight: bold; -fx-text-fill: #334155;"/>
                      <TextField fx:id="txtReturnReason" promptText="Khách dị ứng thuốc..." prefHeight="40.0"/>
                  </VBox>
              </HBox>

              <HBox alignment="CENTER_RIGHT" spacing="15.0" style="-fx-padding: 10 0 0 0;">
                  <Button text="Hủy bỏ" onAction="#handleCloseCreateModal" prefHeight="40.0" prefWidth="100.0" style="-fx-background-color: white; -fx-border-color: #cbd5e1; -fx-border-radius: 5; -fx-cursor: hand; -fx-font-weight: bold;"/>
                  <Button text="Hoàn tiền &amp; Lưu phiếu" onAction="#handleSubmitReturn" prefHeight="40.0" prefWidth="180.0" style="-fx-background-color: #09736a; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5; -fx-cursor: hand;"/>
              </HBox>
          </VBox>
      </StackPane>

   </children>
</AnchorPane>
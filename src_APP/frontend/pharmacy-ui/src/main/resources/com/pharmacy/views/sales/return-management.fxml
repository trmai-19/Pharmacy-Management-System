<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="768.0" prefWidth="1024.0" style="-fx-background-color: transparent;" xmlns="http://javafx.com/javafx/19" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.pharmacy.controller.sales.ReturnManagerController">
    <children>
        <VBox spacing="20.0" AnchorPane.bottomAnchor="20.0" AnchorPane.leftAnchor="30.0" AnchorPane.rightAnchor="30.0" AnchorPane.topAnchor="30.0">
            <children>
                <HBox alignment="CENTER_LEFT" spacing="15.0">
                    <children>
                        <VBox alignment="CENTER" style="-fx-background-color: #e0f2f1; -fx-background-radius: 10; -fx-min-width: 50; -fx-min-height: 50;">
                            <Label text="↩" textFill="#0d94aa"><font><Font name="System Bold" size="24.0" /></font></Label>
                        </VBox>
                        <VBox HBox.hgrow="ALWAYS">
                            <children>
                                <Label text="QUẢN LÝ ĐỔI TRẢ" textFill="#334155">
                                    <font><Font name="System Bold" size="24.0" /></font>
                                </Label>
                            </children>
                        </VBox>
                        
                        <Button onAction="#onBtnShowReturnCustomer" prefHeight="45.0" style="-fx-background-color: transparent; -fx-border-color: #0d94aa; -fx-border-radius: 8; -fx-text-fill: #0d94aa; -fx-cursor: hand;" text="+ Tạo Phiếu Khách Trả">
                            <font><Font name="System Bold" size="14.0" /></font>
                        </Button>
                    </children>
                </HBox>

                <VBox style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 0);" VBox.vgrow="ALWAYS">
                    <children>
                        <HBox alignment="CENTER_LEFT" spacing="15.0">
                            <children>
                                <TextField fx:id="txtSearch" prefHeight="40.0" prefWidth="400.0" promptText="🔍 Tìm mã phiếu, mã hóa đơn..." style="-fx-background-radius: 8;" />
                                <ComboBox fx:id="cbFilterStatus" prefHeight="40.0" prefWidth="200.0" promptText="Tất cả trạng thái" />
                            </children>
                            <VBox.margin><Insets bottom="15.0" /></VBox.margin>
                        </HBox>

                        <TableView fx:id="tableReturn" style="-fx-border-color: transparent;" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="colTicketId" prefWidth="90.0" style="-fx-font-weight: bold;" text="Mã Phiếu" />
                                <TableColumn fx:id="colDate" prefWidth="100.0" text="Ngày tạo" />
                                <TableColumn fx:id="colCustomer" prefWidth="180.0" style="-fx-font-weight: bold;" text="Khách Hàng" />
                                <TableColumn fx:id="colInvoice" prefWidth="120.0" text="Mã Hóa Đơn" />
                                <TableColumn fx:id="colProduct" prefWidth="220.0" text="Sản phẩm trả (Tóm tắt)" />
                                <TableColumn fx:id="colQuantity" prefWidth="80.0" text="Tổng SL" />
                                <TableColumn fx:id="colReason" prefWidth="150.0" text="Lý do" />
                            </columns>
                            <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY" /></columnResizePolicy>
                        </TableView>
                    </children>
                </VBox>
            </children>
        </VBox>

        <!-- Modal Trả Hàng Khách Hàng -->
        <Pane fx:id="modalReturnCustomer" visible="false" style="-fx-background-color: rgba(0,0,0,0.6);" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <children>
                <VBox layoutX="262.0" layoutY="50.0" prefWidth="550.0" spacing="15.0" style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 30; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.2), 20, 0, 0, 10);">
                    <children>
                        <HBox alignment="CENTER_LEFT">
                            <children>
                                <Label text="↩ Phiếu Khách Trả Hàng" textFill="#0d94aa"><font><Font name="System Bold" size="20.0" /></font></Label>
                                <Pane HBox.hgrow="ALWAYS" />
                                <Button onAction="#onBtnHideModals" style="-fx-background-color: transparent; -fx-cursor: hand;" text="✕" textFill="#94a3b8"><font><Font size="18.0" /></font></Button>
                            </children>
                        </HBox>
                        
                        <VBox spacing="8.0">
                            <children>
                                <Label text="Mã hóa đơn gốc *" />
                                <TextField fx:id="txtInvoiceNo" prefHeight="40.0" promptText="🔍 VD: HD-20240418-001" />
                            </children>
                        </VBox>
                        
                        <!-- Khu vực add nhiều sản phẩm -->
                        <VBox spacing="8.0" style="-fx-background-color: #f8fafc; -fx-padding: 10; -fx-background-radius: 8;">
                            <children>
                                <Label text="Chọn sản phẩm trả lại *" style="-fx-font-weight: bold;"/>
                                <HBox spacing="10.0">
                                    <ComboBox fx:id="cbProductCustomer" prefHeight="40.0" promptText="-- Chọn SP từ hóa đơn --" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                                    <TextField fx:id="txtReturnQtyCustomer" prefHeight="40.0" prefWidth="70.0" promptText="SL" />
                                    <Button onAction="#onBtnAddProduct" prefHeight="40.0" style="-fx-background-color: #e2e8f0; -fx-cursor: hand;" text="Thêm" />
                                </HBox>
                                <ListView fx:id="lvReturnProducts" prefHeight="100.0" style="-fx-background-radius: 5;" />
                            </children>
                        </VBox>
                        
                        <HBox spacing="15.0">
                            <children>
                                <VBox spacing="8.0" HBox.hgrow="ALWAYS"><children><Label text="Tổng tiền hoàn (VNĐ) *" /><TextField fx:id="txtRefundAmount" prefHeight="40.0" promptText="0 đ" style="-fx-text-fill: #0d94aa; -fx-font-weight: bold;" /></children></VBox>
                            </children>
                        </HBox>
                        
                        <VBox spacing="8.0"><children><Label text="Lý do khách trả *" /><TextArea fx:id="txtReasonCustomer" prefHeight="60.0" promptText="Ví dụ: Khách mua nhầm loại..." /></children></VBox>
                        
                        <HBox alignment="CENTER_RIGHT" spacing="15.0">
                            <children>
                                <Button onAction="#onBtnHideModals" style="-fx-background-color: transparent; -fx-cursor: hand;" text="Hủy bỏ" textFill="#64748b"><font><Font name="System Bold" size="14.0" /></font></Button>
                                <Button onAction="#onBtnSubmitReturnCustomer" prefHeight="45.0" style="-fx-background-color: #0d94aa; -fx-text-fill: white; -fx-background-radius: 8; -fx-padding: 0 20; -fx-cursor: hand;" text="Hoàn tiền &amp; Lưu phiếu"><font><Font name="System Bold" size="14.0" /></font></Button>
                            </children>
                            <padding><Insets top="10.0" /></padding>
                        </HBox>
                    </children>
                </VBox>
            </children>
        </Pane>
    </children>
</AnchorPane>
<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="800.0" prefWidth="1200.0" style="-fx-background-color: transparent;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.pharmacy.controller.admin.AccountManagerController">
   <children>
      <VBox spacing="20.0" AnchorPane.bottomAnchor="20.0" AnchorPane.leftAnchor="30.0" AnchorPane.rightAnchor="30.0" AnchorPane.topAnchor="20.0">
         <children>
            
            <HBox spacing="20.0">
               <children>
                  <VBox prefWidth="300.0" style="-fx-background-color: white; -fx-background-radius: 12; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 5); -fx-padding: 20;" HBox.hgrow="ALWAYS">
                     <children>
                        <Label style="-fx-text-fill: #64748b; -fx-font-size: 14px; -fx-font-weight: bold;" text="🛡️ TÀI KHOẢN NHÂN SỰ" />
                        <Region prefHeight="10.0" />
                        <HBox alignment="BOTTOM_LEFT" spacing="10.0">
                           <Label fx:id="lblEmpAccounts" style="-fx-font-size: 32px; -fx-font-weight: 900; -fx-text-fill: #0b5d77;" text="12" />
                           <Label style="-fx-text-fill: #ef4444; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 0 0 5 0;" text="(2 Đã nghỉ/Khóa)" />
                        </HBox>
                     </children>
                  </VBox>
                  <VBox prefWidth="300.0" style="-fx-background-color: white; -fx-background-radius: 12; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 5); -fx-padding: 20;" HBox.hgrow="ALWAYS">
                     <children>
                        <Label style="-fx-text-fill: #64748b; -fx-font-size: 14px; -fx-font-weight: bold;" text="🌐 TÀI KHOẢN WEB (KHÁCH HÀNG)" />
                        <Region prefHeight="10.0" />
                        <Label fx:id="lblWebAccounts" style="-fx-font-size: 32px; -fx-font-weight: 900; -fx-text-fill: #0f766e;" text="1,540" />
                     </children>
                  </VBox>
                  <VBox prefWidth="300.0" style="-fx-background-color: white; -fx-background-radius: 12; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 5); -fx-padding: 20;" HBox.hgrow="ALWAYS">
                     <children>
                        <Label style="-fx-text-fill: #64748b; -fx-font-size: 14px; -fx-font-weight: bold;" text="⚠️ TÀI KHOẢN BỊ KHÓA / CẢNH BÁO" />
                        <Region prefHeight="10.0" />
                        <Label fx:id="lblLockedAccounts" style="-fx-font-size: 32px; -fx-font-weight: 900; -fx-text-fill: #f59e0b;" text="8" />
                     </children>
                  </VBox>
               </children>
            </HBox>

            <VBox style="-fx-background-color: white; -fx-background-radius: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 5);" VBox.vgrow="ALWAYS">
               <children>
                  <TabPane prefHeight="500.0" prefWidth="1000.0" style="-fx-background-color: transparent;" tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">
                    <tabs>
                        
                      <Tab style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-padding: 10 30;" text="Tài Khoản Nhân Sự (App)">
                           <content>
                              <VBox spacing="15.0">
                                 <padding>
                                    <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                                 </padding>
                                 <children>
                                    <HBox alignment="CENTER_LEFT" prefHeight="40.0" spacing="15.0">
                                       <children>
                                          <HBox alignment="CENTER_LEFT" prefHeight="40.0" prefWidth="300.0" style="-fx-background-color: #f1f5f9; -fx-background-radius: 8; -fx-padding: 0 15;">
                                             <children>
                                                <Label style="-fx-text-fill: #64748b;" text="🔍" />
                                                <TextField fx:id="txtSearchEmp" promptText="Tìm Username, Tên NV..." style="-fx-background-color: transparent; -fx-font-size: 14px;" HBox.hgrow="ALWAYS" />
                                             </children>
                                          </HBox>
                                          <Region HBox.hgrow="ALWAYS" />
                                          <Button style="-fx-background-color: #f8fafc; -fx-border-color: #cbd5e1; -fx-border-radius: 8; -fx-text-fill: #334155; -fx-font-weight: bold; -fx-cursor: hand;" text="🔄 Đặt lại Mật khẩu" prefHeight="38.0">
                                             <padding><Insets left="15" right="15"/></padding>
                                          </Button>
                                          <Button style="-fx-background-color: #ef4444; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand;" text="🔒 Khóa Tài Khoản" prefHeight="38.0">
                                             <padding><Insets left="15" right="15"/></padding>
                                          </Button>
                                       </children>
                                    </HBox>
                                    
                                    <TableView fx:id="tableEmployeeAcc" style="-fx-font-size: 14px; -fx-selection-bar: #ccfbf1; -fx-background-radius: 8;" VBox.vgrow="ALWAYS">
                                      <columns>
                                        <TableColumn fx:id="colEmpUser" prefWidth="150.0" style="-fx-font-weight: bold;" text="Tên Đăng Nhập" />
                                        <TableColumn fx:id="colEmpName" prefWidth="200.0" text="Tên Nhân Viên" />
                                        <TableColumn fx:id="colEmpRole" prefWidth="120.0" style="-fx-alignment: CENTER;" text="Quyền Hạn" />
                                        <TableColumn fx:id="colEmpStatus" prefWidth="150.0" style="-fx-alignment: CENTER;" text="Trạng Thái" />
                                        <TableColumn fx:id="colEmpLastLogin" prefWidth="180.0" style="-fx-alignment: CENTER;" text="Lần Truy Cập Cuối" />
                                      </columns>
                                       <columnResizePolicy>
                                          <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                       </columnResizePolicy>
                                    </TableView>
                                 </children>
                              </VBox>
                           </content>
                      </Tab>
                      
                      <Tab style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-padding: 10 30;" text="Tài Khoản Khách Hàng (Web)">
                           <content>
                              <VBox spacing="15.0">
                                 <padding>
                                    <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                                 </padding>
                                 <children>
                                    <HBox alignment="CENTER_LEFT" prefHeight="40.0" spacing="15.0">
                                       <children>
                                          <HBox alignment="CENTER_LEFT" prefHeight="40.0" prefWidth="300.0" style="-fx-background-color: #f1f5f9; -fx-background-radius: 8; -fx-padding: 0 15;">
                                             <children>
                                                <Label style="-fx-text-fill: #64748b;" text="🔍" />
                                                <TextField fx:id="txtSearchCust" promptText="Tìm SĐT, Email khách..." style="-fx-background-color: transparent; -fx-font-size: 14px;" HBox.hgrow="ALWAYS" />
                                             </children>
                                          </HBox>
                                          <Region HBox.hgrow="ALWAYS" />
                                          <Button style="-fx-background-color: #f59e0b; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand;" text="🚫 Đình chỉ truy cập Web" prefHeight="38.0">
                                             <padding><Insets left="15" right="15"/></padding>
                                          </Button>
                                       </children>
                                    </HBox>
                                    
                                    <TableView fx:id="tableCustomerAcc" style="-fx-font-size: 14px; -fx-selection-bar: #ccfbf1; -fx-background-radius: 8;" VBox.vgrow="ALWAYS">
                                      <columns>
                                        <TableColumn fx:id="colCustUser" prefWidth="180.0" style="-fx-font-weight: bold;" text="Tài Khoản (SĐT/Email)" />
                                        <TableColumn fx:id="colCustName" prefWidth="200.0" text="Tên Khách Hàng" />
                                        <TableColumn fx:id="colCustRole" prefWidth="120.0" style="-fx-alignment: CENTER;" text="Nền Tảng" />
                                        <TableColumn fx:id="colCustStatus" prefWidth="150.0" style="-fx-alignment: CENTER;" text="Trạng Thái Xác Thực" />
                                        <TableColumn fx:id="colCustLastLogin" prefWidth="180.0" style="-fx-alignment: CENTER;" text="Hoạt Động Cuối" />
                                      </columns>
                                       <columnResizePolicy>
                                          <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                       </columnResizePolicy>
                                    </TableView>
                                 </children>
                              </VBox>
                           </content>
                      </Tab>
                      
                    </tabs>
                  </TabPane>
               </children>
            </VBox>
         </children>
      </VBox>
   </children>
</AnchorPane>
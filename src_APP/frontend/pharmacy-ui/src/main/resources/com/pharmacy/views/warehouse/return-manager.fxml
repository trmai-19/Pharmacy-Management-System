<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="768.0" prefWidth="1024.0" style="-fx-background-color: transparent;" xmlns="http://javafx.com/javafx/19" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.pharmacy.controller.warehouse.ReturnWarehouseController">
    <children>
        <VBox spacing="20.0" AnchorPane.bottomAnchor="20.0" AnchorPane.leftAnchor="30.0" AnchorPane.rightAnchor="30.0" AnchorPane.topAnchor="30.0">
            <children>
                <HBox alignment="CENTER_LEFT" spacing="15.0">
                    <children>
                        <VBox HBox.hgrow="ALWAYS">
                            <children><Label text="Quản Lý Đổi Trả - Nhà Cung Cấp" textFill="#334155"><font><Font name="System Bold" size="24.0" /></font></Label></children>
                        </VBox>
                        <Button fx:id="btnCreateReturn" disable="true" onAction="#onBtnShowReturnNCC" prefHeight="45.0" style="-fx-background-color: #F26822; -fx-background-radius: 8; -fx-text-fill: white; -fx-cursor: hand;" text="＋ Tạo phiếu trả cho Phiếu Nhập này">
                            <font><Font name="System Bold" size="14.0" /></font>
                        </Button>
                    </children>
                </HBox>

                <SplitPane dividerPositions="0.55" orientation="VERTICAL" style="-fx-background-color: transparent; -fx-box-border: transparent;" VBox.vgrow="ALWAYS">
                    <items>
                        <VBox spacing="10.0" style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 0);">
                            <children>
                                <Label text="DANH SÁCH PHIẾU NHẬP (Chọn 1 phiếu để xem/trả hàng)" textFill="#0f766e"><font><Font name="System Bold" size="14.0" /></font></Label>
                                <HBox spacing="15.0">
                                    <children>
                                        <TextField fx:id="txtSearchImport" prefHeight="40.0" prefWidth="400.0" promptText="🔍 Tìm mã phiếu nhập..." style="-fx-background-radius: 8;" />
                                    </children>
                                </HBox>
                                <TableView fx:id="tableImportReceipts" style="-fx-border-color: #e2e8f0; -fx-border-radius: 5;" VBox.vgrow="ALWAYS">
                                    <columns>
                                        <TableColumn fx:id="colImpId" prefWidth="120.0" style="-fx-font-weight: bold;" text="Mã Phiếu Nhập" />
                                        <TableColumn fx:id="colImpDate" prefWidth="120.0" text="Ngày Nhập" />
                                        <TableColumn fx:id="colImpNcc" prefWidth="220.0" text="Nhà Cung Cấp" />
                                        <TableColumn fx:id="colImpTotal" prefWidth="130.0" style="-fx-alignment: CENTER_RIGHT;" text="Tổng Tiền (VNĐ)" />
                                        <TableColumn fx:id="colImpStatus" prefWidth="100.0" style="-fx-alignment: CENTER;" text="Trạng Thái" />
                                        <TableColumn fx:id="colImpActionView" prefWidth="80.0" style="-fx-alignment: CENTER;" text="Chi tiết" />
                                    </columns>
                                    <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY" /></columnResizePolicy>
                                </TableView>
                            </children>
                        </VBox>

                        <VBox spacing="10.0" style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 0);">
                            <children>
                                <Label fx:id="lblDetailReturn" text="LỊCH SỬ TRẢ HÀNG CỦA PHIẾU: ..." textFill="#c2410c"><font><Font name="System Bold" size="14.0" /></font></Label>
                                <TableView fx:id="tableReturn" style="-fx-border-color: #e2e8f0; -fx-border-radius: 5;" VBox.vgrow="ALWAYS">
                                    <columns>
                                        <TableColumn fx:id="colRetId" prefWidth="120.0" style="-fx-font-weight: bold;" text="Mã Phiếu Trả" />
                                        <TableColumn fx:id="colRetDate" prefWidth="120.0" text="Ngày Trả" />
                                        <TableColumn fx:id="colRetReason" prefWidth="250.0" text="Lý do" />
                                        <TableColumn fx:id="colRetTotal" prefWidth="130.0" style="-fx-alignment: CENTER_RIGHT;" text="Tổng Tiền Trả" />
                                        <TableColumn fx:id="colRetActionView" prefWidth="80.0" style="-fx-alignment: CENTER;" text="Chi tiết" />
                                    </columns>
                                    <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY" /></columnResizePolicy>
                                </TableView>
                            </children>
                        </VBox>
                    </items>
                </SplitPane>
            </children>
        </VBox>

        <Pane fx:id="modalReturnNCC" visible="false" style="-fx-background-color: rgba(0,0,0,0.6);" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <children>
                <VBox layoutX="162.0" layoutY="100.0" prefWidth="700.0" spacing="15.0" style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 30; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.2), 20, 0, 0, 10);">
                    <children>
                        <HBox alignment="CENTER_LEFT">
                            <children>
                                <Label text="⚠ Lập Phiếu Xuất Trả Nhà Cung Cấp" textFill="#F26822"><font><Font name="System Bold" size="20.0" /></font></Label>
                                <Pane HBox.hgrow="ALWAYS" />
                                <Button onAction="#onBtnHideModals" style="-fx-background-color: transparent; -fx-cursor: hand;" text="✕" textFill="#94a3b8"><font><Font size="18.0" /></font></Button>
                            </children>
                        </HBox>
                        <HBox spacing="15.0">
                            <children>
                                <VBox spacing="5.0" HBox.hgrow="ALWAYS"><children><Label text="Mã phiếu nhập gốc (Khóa)" /><TextField fx:id="txtMaPhieuNhapReturn" disable="true" prefHeight="35.0" style="-fx-opacity: 1;" /></children></VBox>
                                <VBox spacing="5.0" HBox.hgrow="ALWAYS"><children><Label text="Lý do trả hàng *" /><TextField fx:id="txtLyDoReturn" prefHeight="35.0" promptText="VD: Hàng cận date, sai quy cách..." /></children></VBox>
                            </children>
                        </HBox>
                        <Separator />
                        <HBox alignment="BOTTOM_LEFT" spacing="15.0">
                            <children>
                                <VBox spacing="5.0" HBox.hgrow="ALWAYS"><children><Label text="Mã Lô cần trả *" /><ComboBox fx:id="cbMaLoReturn" prefHeight="35.0" maxWidth="Infinity" promptText="-- Chọn lô cần trả --" /></children></VBox>
                                <VBox spacing="5.0" HBox.hgrow="ALWAYS"><children><Label text="Số lượng trả *" /><TextField fx:id="txtSoLuongReturn" prefHeight="35.0" promptText="Nhập số lượng..." /></children></VBox>
                                <Button onAction="#onBtnAddReturnItem" prefHeight="35.0" style="-fx-background-color: #c2410c; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" text="⬇ Thêm vào danh sách trả" />
                            </children>
                        </HBox>
                        <TableView fx:id="tableReturnItems" prefHeight="180.0" style="-fx-border-color: #e2e8f0; -fx-border-radius: 5;">
                            <columns>
                                <TableColumn fx:id="colRetMaLo" prefWidth="250.0" text="Mã Lô Hàng" />
                                <TableColumn fx:id="colRetQty" prefWidth="150.0" style="-fx-alignment: CENTER;" text="Số Lượng Trả" />
                                <TableColumn fx:id="colRetAction" prefWidth="80.0" style="-fx-alignment: CENTER;" text="Hủy" />
                            </columns>
                            <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY" /></columnResizePolicy>
                        </TableView>
                        <HBox alignment="CENTER_RIGHT" spacing="15.0">
                            <children>
                                <Button onAction="#onBtnHideModals" style="-fx-background-color: transparent; -fx-cursor: hand;" text="Hủy bỏ" textFill="#64748b"><font><Font name="System Bold" size="14.0" /></font></Button>
                                <Button onAction="#onBtnSubmitReturnNCC" prefHeight="45.0" style="-fx-background-color: #F26822; -fx-text-fill: white; -fx-background-radius: 8; -fx-padding: 0 20; -fx-cursor: hand;" text="Xác nhận tạo phiếu"><font><Font name="System Bold" size="14.0" /></font></Button>
                            </children>
                            <padding><Insets top="10.0" /></padding>
                        </HBox>
                    </children>
                </VBox>
            </children>
        </Pane>

        <Pane fx:id="modalViewImport" visible="false" style="-fx-background-color: rgba(0,0,0,0.6);" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <children>
                <VBox layoutX="162.0" layoutY="120.0" prefWidth="700.0" spacing="15.0" style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 30; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.2), 20, 0, 0, 10);">
                    <children>
                        <HBox alignment="CENTER_LEFT">
                            <children>
                                <Label text="📋 Chi Tiết Phiếu Nhập Kho" textFill="#0f766e"><font><Font name="System Bold" size="20.0" /></font></Label>
                                <Pane HBox.hgrow="ALWAYS" />
                                <Button onAction="#onBtnHideModals" style="-fx-background-color: transparent; -fx-cursor: hand;" text="✕" textFill="#94a3b8"><font><Font size="18.0" /></font></Button>
                            </children>
                        </HBox>
                        <Separator />
                        <VBox spacing="8.0">
                            <children>
                                <HBox><Label text="Mã phiếu: " style="-fx-font-weight: bold;"/><Label fx:id="lblViewImpId" text="..." /></HBox>
                                <HBox><Label text="Ngày nhập: " style="-fx-font-weight: bold;"/><Label fx:id="lblViewImpDate" text="..." /></HBox>
                                <HBox><Label text="Nhà CC: " style="-fx-font-weight: bold;"/><Label fx:id="lblViewImpNcc" text="..." /></HBox>
                            </children>
                        </VBox>
                        <TableView fx:id="tableViewImportItems" prefHeight="200.0" style="-fx-border-color: #e2e8f0; -fx-border-radius: 5;">
                            <columns>
                                <TableColumn fx:id="colViewImpMalo" prefWidth="120.0" text="Mã Lô Nhập" />
                                <TableColumn fx:id="colViewImpQty" prefWidth="80.0" style="-fx-alignment: CENTER;" text="Số Lượng" />
                                <TableColumn fx:id="colViewImpPrice" prefWidth="150.0" style="-fx-alignment: CENTER_RIGHT;" text="Giá Nhập (VNĐ)" />
                                <TableColumn fx:id="colViewImpTotal" prefWidth="150.0" style="-fx-alignment: CENTER_RIGHT;" text="Thành Tiền" />
                            </columns>
                            <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY" /></columnResizePolicy>
                        </TableView>
                        <HBox alignment="CENTER_RIGHT">
                            <Label text="Tổng tiền: " style="-fx-font-weight: bold; -fx-font-size: 16px;"/>
                            <Label fx:id="lblViewImpTotal" text="0 VNĐ" textFill="#dc2626" style="-fx-font-weight: bold; -fx-font-size: 16px;"/>
                        </HBox>
                    </children>
                </VBox>
            </children>
        </Pane>

        <Pane fx:id="modalViewReturn" visible="false" style="-fx-background-color: rgba(0,0,0,0.6);" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <children>
                <VBox layoutX="162.0" layoutY="120.0" prefWidth="700.0" spacing="15.0" style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 30; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.2), 20, 0, 0, 10);">
                    <children>
                        <HBox alignment="CENTER_LEFT">
                            <children>
                                <Label text="Biên Lai Trả Hàng Nhà Cung Cấp" textFill="#c2410c"><font><Font name="System Bold" size="20.0" /></font></Label>
                                <Pane HBox.hgrow="ALWAYS" />
                                <Button onAction="#onBtnHideModals" style="-fx-background-color: transparent; -fx-cursor: hand;" text="✕" textFill="#94a3b8"><font><Font size="18.0" /></font></Button>
                            </children>
                        </HBox>
                        <Separator />
                        <HBox spacing="40.0">
                            <VBox spacing="8.0">
                                <children>
                                    <HBox><Label text="Mã phiếu trả: " style="-fx-font-weight: bold;"/><Label fx:id="lblViewRetId" text="..." /></HBox>
                                    <HBox><Label text="Phiếu nhập gốc: " style="-fx-font-weight: bold;"/><Label fx:id="lblViewRetOriginalId" text="..." /></HBox>
                                </children>
                            </VBox>
                            <VBox spacing="8.0">
                                <children>
                                    <HBox><Label text="Ngày trả: " style="-fx-font-weight: bold;"/><Label fx:id="lblViewRetDate" text="..." /></HBox>
                                    <HBox><Label text="Lý do: " style="-fx-font-weight: bold;"/><Label fx:id="lblViewRetReason" text="..." /></HBox>
                                </children>
                            </VBox>
                        </HBox>
                        <TableView fx:id="tableViewReturnItems" prefHeight="200.0" style="-fx-border-color: #e2e8f0; -fx-border-radius: 5;">
                            <columns>
                                <TableColumn fx:id="colViewRetMalo" prefWidth="150.0" text="Mã Lô Trả" />
                                <TableColumn fx:id="colViewRetQty" prefWidth="100.0" style="-fx-alignment: CENTER;" text="Số Lượng Trả" />
                                <TableColumn fx:id="colViewRetPrice" prefWidth="150.0" style="-fx-alignment: CENTER_RIGHT;" text="Đơn Giá Nhập Gốc" />
                                <TableColumn fx:id="colViewRetTotal" prefWidth="150.0" style="-fx-alignment: CENTER_RIGHT;" text="Thành Tiền" />
                            </columns>
                            <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY" /></columnResizePolicy>
                        </TableView>
                        <HBox alignment="CENTER_RIGHT">
                            <Label text="Tổng giá trị xuất trả: " style="-fx-font-weight: bold; -fx-font-size: 16px;"/>
                            <Label fx:id="lblViewRetTotal" text="0 VNĐ" textFill="#c2410c" style="-fx-font-weight: bold; -fx-font-size: 16px;"/>
                        </HBox>
                    </children>
                </VBox>
            </children>
        </Pane>

    </children>
</AnchorPane>
<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="768.0" prefWidth="1024.0" style="-fx-background-color: transparent;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.pharmacy.controller.warehouse.ReturnWarehouseController">
    <children>
        <VBox spacing="20.0" AnchorPane.bottomAnchor="20.0" AnchorPane.leftAnchor="30.0" AnchorPane.rightAnchor="30.0" AnchorPane.topAnchor="30.0">
            <children>
                <HBox alignment="CENTER_LEFT" spacing="15.0">
                    <children>
                        <VBox HBox.hgrow="ALWAYS">
                            <children><Label text="Quản Lý Đổi Trả - Nhà Cung Cấp" textFill="#334155"><font><Font name="System Bold" size="24.0" /></font></Label></children>
                        </VBox>
                        <Button fx:id="btnCreateReturn" disable="true" onAction="#onBtnShowReturnNCC" prefHeight="45.0" style="-fx-background-color: #ea580c; -fx-background-radius: 8; -fx-text-fill: white; -fx-cursor: hand; -fx-padding: 0 20;" text="＋ Tạo phiếu trả cho Phiếu Nhập này">
                            <font><Font name="System Bold" size="14.0" /></font>
                        </Button>
                    </children>
                </HBox>

                <SplitPane dividerPositions="0.6" orientation="VERTICAL" style="-fx-background-color: transparent; -fx-padding: 0;" VBox.vgrow="ALWAYS">
                    <items>
                        <VBox style="-fx-background-color: white; -fx-background-radius: 12; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 5); -fx-padding: 20;" VBox.vgrow="ALWAYS">
                            <children>
                                <Label text="DANH SÁCH PHIẾU NHẬP (Chọn 1 phiếu để xem/trả hàng)" style="-fx-font-weight: 900; -fx-text-fill: #0f766e; -fx-font-size: 15px;">
                                    <VBox.margin><Insets bottom="15.0" /></VBox.margin>
                                </Label>
                                <HBox spacing="15.0">
                                    <children>
                                        <TextField fx:id="txtSearchImport" prefHeight="42.0" prefWidth="400.0" promptText="🔍 Tìm mã phiếu nhập..." style="-fx-background-radius: 8; -fx-background-color: #f1f5f9; -fx-border-color: #cbd5e1; -fx-border-radius: 8;" />
                                    </children>
                                    <VBox.margin><Insets bottom="15.0" /></VBox.margin>
                                </HBox>
                                <TableView fx:id="tableImportReceipts" style="-fx-font-size: 14px; -fx-selection-bar: #0ea5e9; -fx-selection-bar-text: white;" VBox.vgrow="ALWAYS">
                                    <columns>
                                        <TableColumn fx:id="colImpId" prefWidth="110.0" style="-fx-font-weight: bold;" text="Mã Phiếu Nhập" />
                                        <TableColumn fx:id="colImpDate" prefWidth="100.0" style="-fx-alignment: CENTER;" text="Ngày Nhập" />
                                        <TableColumn fx:id="colImpNcc" prefWidth="200.0" text="Nhà Cung Cấp" />
                                        <TableColumn fx:id="colImpTotal" prefWidth="130.0" style="-fx-alignment: CENTER_RIGHT; -fx-font-weight: bold;" text="Tổng Tiền (VNĐ)" />
                                        <TableColumn fx:id="colImpStatus" prefWidth="100.0" style="-fx-alignment: CENTER;" text="Trạng Thái" />
                                        <TableColumn fx:id="colImpActionView" prefWidth="60.0" style="-fx-alignment: CENTER;" text="Chi tiết" />
                                    </columns>
                                    <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY" /></columnResizePolicy>
                                </TableView>
                            </children>
                        </VBox>

                        <VBox style="-fx-background-color: white; -fx-background-radius: 12; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 5); -fx-padding: 20;" VBox.vgrow="ALWAYS">
                            <children>
                                <Label fx:id="lblDetailReturn" text="LỊCH SỬ TRẢ HÀNG CỦA PHIẾU: ..." style="-fx-font-weight: 900; -fx-text-fill: #ea580c; -fx-font-size: 15px;">
                                    <VBox.margin><Insets bottom="15.0" /></VBox.margin>
                                </Label>
                                <TableView fx:id="tableReturn" style="-fx-font-size: 14px; -fx-selection-bar: #0ea5e9; -fx-selection-bar-text: white;" VBox.vgrow="ALWAYS">
                                    <columns>
                                        <TableColumn fx:id="colRetId" prefWidth="130.0" style="-fx-font-weight: bold;" text="Mã Phiếu Trả" />
                                        <TableColumn fx:id="colRetDate" prefWidth="120.0" style="-fx-alignment: CENTER;" text="Ngày Trả" />
                                        <TableColumn fx:id="colRetReason" prefWidth="300.0" text="Lý do trả hàng" />
                                        <TableColumn fx:id="colRetTotal" prefWidth="150.0" style="-fx-alignment: CENTER_RIGHT; -fx-font-weight: bold; -fx-text-fill: #ea580c;" text="Tổng Tiền Trả" />
                                        <TableColumn fx:id="colRetActionView" prefWidth="90.0" style="-fx-alignment: CENTER;" text="Chi tiết" />
                                    </columns>
                                    <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY" /></columnResizePolicy>
                                </TableView>
                            </children>
                        </VBox>
                    </items>
                </SplitPane>
            </children>
        </VBox>

        <StackPane fx:id="modalReturnNCC" visible="false" alignment="CENTER" style="-fx-background-color: rgba(0,0,0,0.6);" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <children>
                <VBox maxWidth="780.0" maxHeight="620.0" spacing="20.0" style="-fx-background-color: white; -fx-background-radius: 16; -fx-padding: 30; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.3), 25, 0, 0, 10);">
                    <children>
                        <HBox alignment="CENTER_LEFT">
                             <children>
                                <Label text="⚠ Lập Phiếu Xuất Trả Nhà Cung Cấp" textFill="#ea580c" style="-fx-font-size: 24px; -fx-font-weight: 900;" />
                                <Pane HBox.hgrow="ALWAYS" />
                                <Button onAction="#onBtnHideModals" style="-fx-background-color: transparent; -fx-cursor: hand;" text="✕" textFill="#94a3b8"><font><Font name="System Bold" size="20.0" /></font></Button>
                            </children>
                        </HBox>
                        
                        <Separator />
                        
                        <VBox spacing="16.0" style="-fx-background-color: #f8fafc; -fx-padding: 20; -fx-border-color: #e2e8f0; -fx-border-radius: 10; -fx-background-radius: 10;">
                            <HBox spacing="20.0">
                                <children>
                                    <VBox spacing="6.0" prefWidth="240.0">
                                        <children>
                                            <Label text="Mã phiếu nhập gốc" style="-fx-font-weight: bold; -fx-text-fill: #475569;" />
                                            <TextField fx:id="txtMaPhieuNhapReturn" disable="true" prefHeight="42.0" style="-fx-opacity: 1; -fx-font-weight: bold; -fx-text-fill: #0f172a; -fx-background-color: #e2e8f0; -fx-border-radius: 6; -fx-background-radius: 6;" />
                                        </children>
                                    </VBox>
                                    <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                                        <children>
                                            <Label text="Lý do trả hàng *" style="-fx-font-weight: bold; -fx-text-fill: #475569;" />
                                            <TextField fx:id="txtLyDoReturn" prefHeight="42.0" promptText="VD: Hàng cận date, sai quy cách..." style="-fx-background-radius: 6; -fx-border-color: #cbd5e1; -fx-border-radius: 6;" />
                                        </children>
                                    </VBox>
                                </children>
                            </HBox>
                            
                            <HBox alignment="BOTTOM_LEFT" spacing="15.0">
                                <children>
                                    <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                                        <children>
                                            <Label text="Sản phẩm cần trả *" style="-fx-font-weight: bold; -fx-text-fill: #475569;" />
                                            <ComboBox fx:id="cbMaLoReturn" prefHeight="42.0" maxWidth="Infinity" promptText="-- Chọn sản phẩm (Mã lô) --" style="-fx-background-radius: 6; -fx-border-color: #cbd5e1; -fx-border-radius: 6;" />
                                        </children>
                                    </VBox>
                                    <VBox spacing="6.0" prefWidth="120.0">
                                        <children>
                                            <Label text="Số lượng trả *" style="-fx-font-weight: bold; -fx-text-fill: #475569;" />
                                            <TextField fx:id="txtSoLuongReturn" prefHeight="42.0" promptText="VD: 50" style="-fx-background-radius: 6; -fx-border-color: #cbd5e1; -fx-border-radius: 6;" />
                                        </children>
                                    </VBox>
                                    <Button onAction="#onBtnAddReturnItem" prefHeight="42.0" style="-fx-background-color: #ea580c; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-background-radius: 6; -fx-padding: 0 20;" text="⬇ Thêm vào DS" />
                                </children>
                            </HBox>
                        </VBox>

                        <VBox style="-fx-border-color: #e2e8f0; -fx-border-radius: 8; -fx-padding: 1;" VBox.vgrow="ALWAYS">
                            <TableView fx:id="tableReturnItems" prefHeight="180.0" style="-fx-font-size: 14px; -fx-background-radius: 8; -fx-border-radius: 8;">
                                <columns>
                                    <TableColumn fx:id="colRetMaLo" prefWidth="350.0" text="Sản Phẩm (Mã Lô)" />
                                    <TableColumn fx:id="colRetQty" prefWidth="150.0" style="-fx-alignment: CENTER;" text="Số Lượng Trả" />
                                    <TableColumn fx:id="colRetAction" prefWidth="80.0" style="-fx-alignment: CENTER;" text="Hủy" />
                                </columns>
                                <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY" /></columnResizePolicy>
                            </TableView>
                        </VBox>

                        <HBox alignment="CENTER_RIGHT" spacing="15.0" style="-fx-padding: 10 0 0 0;">
                            <children>
                                <Button onAction="#onBtnHideModals" prefHeight="45.0" style="-fx-background-color: white; -fx-border-color: #cbd5e1; -fx-border-radius: 8; -fx-cursor: hand; -fx-padding: 0 30;" text="Hủy bỏ" textFill="#64748b"><font><Font name="System Bold" size="14.0" /></font></Button>
                                <Button onAction="#onBtnSubmitReturnNCC" prefHeight="45.0" style="-fx-background-color: #ea580c; -fx-text-fill: white; -fx-background-radius: 8; -fx-padding: 0 30; -fx-cursor: hand;" text="Xác nhận tạo phiếu"><font><Font name="System Bold" size="14.0" /></font></Button>
                            </children>
                        </HBox>
                    </children>
                </VBox>
            </children>
        </StackPane>

        <StackPane fx:id="modalViewImport" visible="false" alignment="CENTER" style="-fx-background-color: rgba(0,0,0,0.6);" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <children>
                <VBox maxWidth="800.0" maxHeight="600.0" spacing="15.0" style="-fx-background-color: white; -fx-background-radius: 16; -fx-padding: 30; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.3), 25, 0, 0, 10);">
                    <children>
                        <HBox alignment="CENTER_LEFT">
                            <children>
                                <Label text="📋 Chi Tiết Phiếu Nhập Kho" textFill="#0f766e"><font><Font name="System Bold" size="22.0" /></font></Label>
                                <Pane HBox.hgrow="ALWAYS" />
                                <Button onAction="#onBtnHideModals" style="-fx-background-color: transparent; -fx-cursor: hand;" text="✕" textFill="#94a3b8"><font><Font name="System Bold" size="20.0" /></font></Button>
                            </children>
                        </HBox>
                        <Separator />
                        <HBox spacing="30.0" style="-fx-background-color: #f8fafc; -fx-padding: 15; -fx-background-radius: 8; -fx-border-color: #e2e8f0; -fx-border-radius: 8;">
                            <VBox spacing="8.0">
                                <children>
                                    <HBox><Label text="Mã phiếu: " style="-fx-font-weight: bold; -fx-text-fill: #475569;"/><Label fx:id="lblViewImpId" text="..." style="-fx-font-weight: bold;" /></HBox>
                                    <HBox><Label text="Nhà CC: " style="-fx-font-weight: bold; -fx-text-fill: #475569;"/><Label fx:id="lblViewImpNcc" text="..." /></HBox>
                                </children>
                            </VBox>
                            <VBox spacing="8.0">
                                <HBox><Label text="Ngày nhập: " style="-fx-font-weight: bold; -fx-text-fill: #475569;"/><Label fx:id="lblViewImpDate" text="..." /></HBox>
                            </VBox>
                        </HBox>
                        <VBox style="-fx-border-color: #e2e8f0; -fx-border-radius: 8; -fx-padding: 1;" VBox.vgrow="ALWAYS">
                            <TableView fx:id="tableViewImportItems" prefHeight="250.0" style="-fx-font-size: 14px; -fx-background-radius: 8; -fx-border-radius: 8;">
                                <columns>
                                    <TableColumn fx:id="colViewImpProductName" prefWidth="250.0" text="Tên Sản Phẩm" />
                                    <TableColumn fx:id="colViewImpMalo" prefWidth="120.0" style="-fx-alignment: CENTER;" text="Mã Lô Nhập" />
                                    <TableColumn fx:id="colViewImpQty" prefWidth="90.0" style="-fx-alignment: CENTER;" text="Số Lượng" />
                                    <TableColumn fx:id="colViewImpPrice" prefWidth="130.0" style="-fx-alignment: CENTER_RIGHT;" text="Giá Nhập (VNĐ)" />
                                    <TableColumn fx:id="colViewImpTotal" prefWidth="150.0" style="-fx-alignment: CENTER_RIGHT; -fx-font-weight: bold;" text="Thành Tiền" />
                                </columns>
                                <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY" /></columnResizePolicy>
                            </TableView>
                        </VBox>
                        <HBox alignment="CENTER_RIGHT" style="-fx-padding: 10 0 0 0;">
                            <Label text="Tổng tiền: " style="-fx-font-weight: bold; -fx-font-size: 18px; -fx-text-fill: #475569;"/>
                            <Label fx:id="lblViewImpTotal" text="0 VNĐ" textFill="#dc2626" style="-fx-font-weight: 900; -fx-font-size: 20px;"/>
                        </HBox>
                    </children>
                </VBox>
            </children>
        </StackPane>

        <StackPane fx:id="modalViewReturn" visible="false" alignment="CENTER" style="-fx-background-color: rgba(0,0,0,0.6);" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <children>
                <VBox maxWidth="800.0" maxHeight="600.0" spacing="15.0" style="-fx-background-color: white; -fx-background-radius: 16; -fx-padding: 30; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.3), 25, 0, 0, 10);">
                    <children>
                        <HBox alignment="CENTER_LEFT">
                            <children>
                                <Label text="📄 Biên Lai Trả Hàng Nhà Cung Cấp" textFill="#ea580c"><font><Font name="System Bold" size="22.0" /></font></Label>
                                <Pane HBox.hgrow="ALWAYS" />
                                <Button onAction="#onBtnHideModals" style="-fx-background-color: transparent; -fx-cursor: hand;" text="✕" textFill="#94a3b8"><font><Font name="System Bold" size="20.0" /></font></Button>
                            </children>
                        </HBox>
                        <Separator />
                        <HBox spacing="40.0" style="-fx-background-color: #fff7ed; -fx-padding: 15; -fx-background-radius: 8; -fx-border-color: #ffedd5; -fx-border-radius: 8;">
                            <VBox spacing="8.0">
                                <children>
                                    <HBox><Label text="Mã phiếu trả: " style="-fx-font-weight: bold; -fx-text-fill: #ea580c;"/><Label fx:id="lblViewRetId" text="..." style="-fx-font-weight: bold;"/></HBox>
                                    <HBox><Label text="Phiếu nhập gốc: " style="-fx-font-weight: bold; -fx-text-fill: #475569;"/><Label fx:id="lblViewRetOriginalId" text="..." /></HBox>
                                </children>
                            </VBox>
                            <VBox spacing="8.0">
                                <children>
                                    <HBox><Label text="Ngày trả: " style="-fx-font-weight: bold; -fx-text-fill: #475569;"/><Label fx:id="lblViewRetDate" text="..." /></HBox>
                                    <HBox><Label text="Lý do: " style="-fx-font-weight: bold; -fx-text-fill: #475569;"/><Label fx:id="lblViewRetReason" text="..." /></HBox>
                                </children>
                            </VBox>
                        </HBox>
                        <VBox style="-fx-border-color: #e2e8f0; -fx-border-radius: 8; -fx-padding: 1;" VBox.vgrow="ALWAYS">
                            <TableView fx:id="tableViewReturnItems" prefHeight="250.0" style="-fx-font-size: 14px; -fx-background-radius: 8; -fx-border-radius: 8;">
                                <columns>
                                    <TableColumn fx:id="colViewRetProductName" prefWidth="250.0" text="Tên Sản Phẩm" />
                                    <TableColumn fx:id="colViewRetMalo" prefWidth="120.0" style="-fx-alignment: CENTER;" text="Mã Lô Trả" />
                                    <TableColumn fx:id="colViewRetQty" prefWidth="100.0" style="-fx-alignment: CENTER;" text="Số Lượng Trả" />
                                    <TableColumn fx:id="colViewRetPrice" prefWidth="130.0" style="-fx-alignment: CENTER_RIGHT;" text="Đơn Giá Nhập Gốc" />
                                    <TableColumn fx:id="colViewRetTotal" prefWidth="150.0" style="-fx-alignment: CENTER_RIGHT; -fx-font-weight: bold; -fx-text-fill: #ea580c;" text="Thành Tiền" />
                                </columns>
                                <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY" /></columnResizePolicy>
                            </TableView>
                        </VBox>
                        <HBox alignment="CENTER_RIGHT" style="-fx-padding: 10 0 0 0;">
                            <Label text="Tổng giá trị xuất trả: " style="-fx-font-weight: bold; -fx-font-size: 18px; -fx-text-fill: #475569;"/>
                            <Label fx:id="lblViewRetTotal" text="0 VNĐ" textFill="#ea580c" style="-fx-font-weight: 900; -fx-font-size: 20px;"/>
                        </HBox>
                    </children>
                </VBox>
            </children>
        </StackPane>
    </children>
</AnchorPane>
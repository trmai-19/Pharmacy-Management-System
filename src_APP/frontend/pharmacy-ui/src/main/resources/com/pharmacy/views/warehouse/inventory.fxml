<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="768.0" prefWidth="1024.0" style="-fx-background-color: #F4F7F6;" xmlns="http://javafx.com/javafx/19" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.pharmacy.controller.warehouse.InventoryController">
   <children>
      <VBox spacing="20.0" AnchorPane.bottomAnchor="20.0" AnchorPane.leftAnchor="30.0" AnchorPane.rightAnchor="30.0" AnchorPane.topAnchor="30.0">
         <children>
            <HBox alignment="CENTER_LEFT" spacing="10.0">
               <children>
                  <Pane HBox.hgrow="ALWAYS" />
                  <Button onAction="#onBtnAddSupplierNew" prefHeight="45.0" style="-fx-background-color: white; -fx-border-color: #8b5cf6; -fx-border-radius: 8; -fx-text-fill: #8b5cf6; -fx-cursor: hand;" text="+ Thêm Nhà Cung Cấp">
                     <font><Font name="System Bold" size="13.0" /></font>
                  </Button>
                  <Button onAction="#onBtnAddProductNew" prefHeight="45.0" style="-fx-background-color: white; -fx-border-color: #3b82f6; -fx-border-radius: 8; -fx-text-fill: #3b82f6; -fx-cursor: hand;" text="+ Thêm Sản Phẩm">
                     <font><Font name="System Bold" size="13.0" /></font>
                  </Button>
                  
                  <Button onAction="#handleAddProduct" prefHeight="45.0" style="-fx-background-color: #0d94aa; -fx-background-radius: 8; -fx-text-fill: white; -fx-cursor: hand;" text="+ Nhập Lô Mới">
                     <font><Font name="System Bold" size="14.0" /></font>
                  </Button>
               </children>
            </HBox>

            <HBox spacing="20.0">
               <children>
                  <VBox prefHeight="80.0" style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 0);" HBox.hgrow="ALWAYS">
                     <children><Label text="TỔNG MẶT HÀNG TRONG HỆ THỐNG" textFill="#64748b"><font><Font name="System Bold" size="12.0" /></font></Label><Label fx:id="lblTotalProducts" text="0" textFill="#0d94aa"><font><Font name="System Bold" size="28.0" /></font></Label></children>
                  </VBox>
                  <VBox prefHeight="80.0" style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 0);" HBox.hgrow="ALWAYS">
                     <children><Label text="SẮP HẾT HÀNG (CẦN NHẬP)" textFill="#64748b"><font><Font name="System Bold" size="12.0" /></font></Label><Label fx:id="lblLowStock" text="0" textFill="#f97316"><font><Font name="System Bold" size="28.0" /></font></Label></children>
                  </VBox>
                  <VBox prefHeight="80.0" style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 0);" HBox.hgrow="ALWAYS">
                     <children><Label text="CẬN DATE / HẾT HẠN (CẦN XỬ LÝ)" textFill="#64748b"><font><Font name="System Bold" size="12.0" /></font></Label><Label fx:id="lblExpiring" text="0" textFill="#dc3545"><font><Font name="System Bold" size="28.0" /></font></Label></children>
                  </VBox>
               </children>
            </HBox>

            <VBox style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 15;" VBox.vgrow="ALWAYS">
               <children>
                  <HBox alignment="CENTER_LEFT" spacing="15.0">
                     <children>
                        <TextField fx:id="txtSearch" prefHeight="40.0" prefWidth="350.0" promptText="🔍 Tìm mã sản phẩm, tên thuốc..." style="-fx-background-radius: 8;" />
                        <ComboBox fx:id="cbCategory" prefHeight="40.0" prefWidth="200.0" promptText="Đang tải danh mục..." />
                        <Pane HBox.hgrow="ALWAYS" />
                        <Button onAction="#onBtnXuatExcelClick" prefHeight="40.0" style="-fx-background-color: #10b981; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6;" text="⬇ Xuất Báo Cáo Tồn Kho" />
                     </children>
                     <VBox.margin><Insets bottom="15.0" /></VBox.margin>
                  </HBox>
                  
                  <SplitPane dividerPositions="0.55" orientation="VERTICAL" style="-fx-background-color: transparent; -fx-box-border: transparent;" VBox.vgrow="ALWAYS">
                     <items>
                        <VBox>
                           <children>
                              <TableView fx:id="tableProduct" style="-fx-border-color: #e2e8f0; -fx-border-radius: 5;" VBox.vgrow="ALWAYS">
                                 <columns>
                                    <TableColumn fx:id="colId" prefWidth="90.0" text="Mã SP" />
                                    <TableColumn fx:id="colName" prefWidth="200.0" text="Tên sản phẩm" />
                                    <TableColumn fx:id="colUnit" prefWidth="60.0" style="-fx-alignment: CENTER;" text="ĐVT" />
                                    <TableColumn fx:id="colIngredient" prefWidth="150.0" text="Thành phần" />
                                    <TableColumn fx:id="colCategory" prefWidth="130.0" text="Danh mục" />
                                    <TableColumn fx:id="colUsage" prefWidth="150.0" text="Công dụng" />
                                    <TableColumn fx:id="colPrice" prefWidth="100.0" style="-fx-alignment: CENTER_RIGHT;" text="Giá bán" />
                                 </columns>
                                 <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY" /></columnResizePolicy>
                              </TableView>
                           </children>
                        </VBox>
                        
                        <VBox spacing="8.0">
                           <children>
                              <Label text="CHI TIẾT LÔ HÀNG NHẬP THỰC TẾ" textFill="#0f766e"><font><Font name="System Bold" size="14.0" /></font><VBox.margin><Insets top="5.0" /></VBox.margin></Label>
                              <TableView fx:id="tableBatch" style="-fx-border-color: #e2e8f0; -fx-border-radius: 5;" VBox.vgrow="ALWAYS">
                                 <columns>
                                    <TableColumn fx:id="colBatchId" prefWidth="100.0" text="Mã lô nhập" />
                                    <TableColumn fx:id="colMfgDate" prefWidth="110.0" style="-fx-alignment: CENTER;" text="Ngày sản xuất" />
                                    <TableColumn fx:id="colExpDate" prefWidth="110.0" style="-fx-alignment: CENTER;" text="Hạn sử dụng" />
                                    <TableColumn fx:id="colImportDate" prefWidth="110.0" style="-fx-alignment: CENTER;" text="Ngày nhập" />
                                    <TableColumn fx:id="colImportPrice" prefWidth="120.0" style="-fx-alignment: CENTER_RIGHT;" text="Giá nhập (VNĐ)" />
                                    <TableColumn fx:id="colBatchQuantity" prefWidth="110.0" style="-fx-alignment: CENTER;" text="Số lượng tồn" />
                                    <TableColumn fx:id="colBatchStatus" prefWidth="90.0" style="-fx-alignment: CENTER;" text="Tình trạng" />
                                 </columns>
                                 <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY" /></columnResizePolicy>
                              </TableView>
                           </children>
                        </VBox>
                     </items>
                  </SplitPane>
               </children>
            </VBox>
         </children>
      </VBox>

      <StackPane fx:id="modalNhapKho" style="-fx-background-color: rgba(0,0,0,0.6);" visible="false" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <children>
            <VBox maxHeight="-Infinity" maxWidth="-Infinity" prefWidth="920.0" spacing="15.0" style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 25; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.3), 20, 0, 0, 0);">
               <children>
                  <HBox alignment="CENTER_LEFT">
                     <children>
                        <Label text="📦 Lập Phiếu Nhập Kho Hệ Thống" textFill="#0d94aa"><font><Font name="System Bold" size="20.0" /></font></Label>
                        <Pane HBox.hgrow="ALWAYS" />
                        <Button onAction="#onBtnHideModals" style="-fx-background-color: transparent; -fx-cursor: hand;" text="✕"><font><Font size="18.0" /></font></Button>
                     </children>
                  </HBox>
                  <HBox alignment="CENTER_LEFT" spacing="15.0">
                      <children>
                          <Label style="-fx-font-weight: bold;" text="Nhà cung cấp lập phiếu (*):" />
                          <ComboBox fx:id="cbNhaCungCapImport" editable="true" prefHeight="35.0" prefWidth="320.0" promptText="Gõ mã hoặc tên để tìm..." />
                      </children>
                  </HBox>
                  <Separator />
                  <GridPane hgap="15.0" vgap="10.0">
                    <columnConstraints>
                      <ColumnConstraints hgrow="SOMETIMES" percentWidth="33.3" />
                      <ColumnConstraints hgrow="SOMETIMES" percentWidth="33.3" />
                      <ColumnConstraints hgrow="SOMETIMES" percentWidth="33.3" />
                    </columnConstraints>
                    <rowConstraints>
                      <RowConstraints minHeight="10.0" prefHeight="55.0" vgrow="SOMETIMES" />
                      <RowConstraints minHeight="10.0" prefHeight="55.0" vgrow="SOMETIMES" />
                      <RowConstraints minHeight="10.0" prefHeight="55.0" vgrow="SOMETIMES" />
                    </rowConstraints>
                     <children>
                        <VBox spacing="5.0"><children><Label text="Lựa chọn sản phẩm thuốc *" /><ComboBox fx:id="cbSanPhamImport" editable="true" maxWidth="Infinity" prefHeight="35.0" promptText="Gõ mã hoặc tên để tìm..." /></children></VBox>
                        <VBox spacing="5.0" GridPane.columnIndex="1"><children><Label text="Kho xếp hàng *" /><ComboBox fx:id="cbKhoImport" maxWidth="Infinity" prefHeight="35.0" promptText="Chọn kho lưu trữ..." /></children></VBox>
                        <VBox spacing="5.0" GridPane.columnIndex="2"><children><Label text="Đơn vị tính quy chuẩn *" /><TextField fx:id="txtDvtImport" prefHeight="35.0" promptText="VD: Hộp, Lọ, Chai..." /></children></VBox>
                        
                        <VBox spacing="5.0" GridPane.rowIndex="1"><children><Label text="Ngày sản xuất (MFG Date)" /><DatePicker fx:id="dpNgaySanXuatImport" maxWidth="Infinity" prefHeight="35.0" /></children></VBox>
                        <VBox spacing="5.0" GridPane.columnIndex="1" GridPane.rowIndex="1"><children><Label text="Hạn sử dụng (EXP Date) *" /><DatePicker fx:id="dpHanSuDungImport" maxWidth="Infinity" prefHeight="35.0" /></children></VBox>
                        <VBox spacing="5.0" GridPane.columnIndex="2" GridPane.rowIndex="1"><children><Label text="Ghi chú thêm lô" /><TextField fx:id="txtGhiChuImport" prefHeight="35.0" promptText="Nhập ghi chú chi tiết..." /></children></VBox>

                        <VBox spacing="5.0" GridPane.rowIndex="2"><children><Label text="Số lượng nhập kho *" /><TextField fx:id="txtSoLuongImport" prefHeight="35.0" promptText="VD: 50" /></children></VBox>
                        <VBox spacing="5.0" GridPane.columnIndex="1" GridPane.rowIndex="2"><children><Label text="Đơn giá nhập thực tế (VNĐ) *" /><TextField fx:id="txtGiaNhapImport" prefHeight="35.0" promptText="VD: 45000" /></children></VBox>
                        <VBox alignment="BOTTOM_CENTER" GridPane.columnIndex="2" GridPane.rowIndex="2">
                           <children>
                              <Button maxWidth="Infinity" onAction="#onBtnAddImportItem" prefHeight="35.0" style="-fx-background-color: #10b981; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" text="⬇ Thêm mặt hàng vào phiếu" />
                           </children>
                        </VBox>
                     </children>
                  </GridPane>

                  <TableView fx:id="tableImportItems" prefHeight="180.0" style="-fx-border-color: #e2e8f0; -fx-border-radius: 5;">
                     <columns>
                        <TableColumn fx:id="colImpProductName" prefWidth="220.0" text="Tên Sản Phẩm Thuốc" />
                        <TableColumn fx:id="colImpKho" prefWidth="100.0" text="Mã Kho" />
                        <TableColumn fx:id="colImpQty" prefWidth="80.0" style="-fx-alignment: CENTER;" text="Số Lượng" />
                        <TableColumn fx:id="colImpPrice" prefWidth="130.0" style="-fx-alignment: CENTER_RIGHT;" text="Đơn Giá Nhập" />
                        <TableColumn fx:id="colImpMfg" prefWidth="110.0" style="-fx-alignment: CENTER;" text="Ngày SX" />
                        <TableColumn fx:id="colImpExp" prefWidth="110.0" style="-fx-alignment: CENTER;" text="Hạn Sử Dụng" />
                        <TableColumn fx:id="colImpAction" prefWidth="85.0" style="-fx-alignment: CENTER;" text="Hủy dòng" />
                     </columns>
                     <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY" /></columnResizePolicy>
                  </TableView>

                  <HBox alignment="CENTER_RIGHT" spacing="15.0">
                     <children>
                        <Label fx:id="lblTotalImportValue" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #dc2626;" text="Tổng tiền phiếu: 0 VNĐ" />
                        <Pane HBox.hgrow="ALWAYS" />
                        <Button onAction="#onBtnHideModals" prefHeight="40.0" prefWidth="100.0" style="-fx-background-color: white; -fx-border-color: #e2e8f0; -fx-cursor: hand;" text="Hủy bỏ" />
                        <Button onAction="#onBtnXacNhanNhapKhoClick" prefHeight="40.0" prefWidth="180.0" style="-fx-background-color: #0d94aa; -fx-text-fill: white; -fx-background-radius: 8; -fx-cursor: hand; -fx-font-weight: bold;" text="Xác nhận Lưu Phiếu" />
                     </children>
                  </HBox>
               </children>
            </VBox>
         </children>
      </StackPane>

      <StackPane fx:id="modalAddProduct" style="-fx-background-color: rgba(0,0,0,0.6);" visible="false" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <children>
            <VBox maxHeight="-Infinity" maxWidth="-Infinity" prefWidth="600.0" spacing="15.0" style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 25; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.3), 20, 0, 0, 0);">
               <children>
                  <HBox alignment="CENTER_LEFT">
                     <children>
                        <Label text="💊 Thêm Sản Phẩm Thuốc Mới" textFill="#3b82f6"><font><Font name="System Bold" size="20.0" /></font></Label>
                        <Pane HBox.hgrow="ALWAYS" />
                        <Button onAction="#onBtnHideModals" style="-fx-background-color: transparent; -fx-cursor: hand;" text="✕"><font><Font size="18.0" /></font></Button>
                     </children>
                  </HBox>
                  <Separator />
                  <VBox spacing="10.0">
                     <children>
                        <Label text="Tên sản phẩm *" /><TextField fx:id="txtTenSpNew" prefHeight="35.0" promptText="VD: Panadol Extra" />
                        <HBox spacing="15.0">
                            <VBox spacing="5.0" HBox.hgrow="ALWAYS"><children><Label text="Danh mục thuốc *" /><ComboBox fx:id="cbCategoryNew" prefHeight="35.0" maxWidth="Infinity" promptText="Chọn danh mục" /></children></VBox>
                            <VBox spacing="5.0" HBox.hgrow="ALWAYS"><children><Label text="Đơn vị tính *" /><TextField fx:id="txtDvtSpNew" prefHeight="35.0" promptText="VD: Viên, Vỉ, Hộp..." /></children></VBox>
                        </HBox>
                        <Label text="Thành phần hóa học" /><TextField fx:id="txtThanhPhanNew" prefHeight="35.0" promptText="VD: Paracetamol 500mg" />
                        <Label text="Công dụng chỉ định" /><TextField fx:id="txtCongDungNew" prefHeight="35.0" promptText="VD: Giảm đau, hạ sốt" />
                     </children>
                  </VBox>
                  <HBox alignment="CENTER_RIGHT" spacing="10.0" style="-fx-padding: 10 0 0 0;">
                     <children>
                        <Button onAction="#onBtnHideModals" prefHeight="40.0" style="-fx-background-color: white; -fx-border-color: #e2e8f0; -fx-cursor: hand;" text="Hủy bỏ" />
                        <Button onAction="#onBtnSubmitAddProduct" prefHeight="40.0" style="-fx-background-color: #3b82f6; -fx-text-fill: white; -fx-background-radius: 8; -fx-cursor: hand; -fx-font-weight: bold;" text="Lưu Sản Phẩm" />
                     </children>
                  </HBox>
               </children>
            </VBox>
         </children>
      </StackPane>

      <StackPane fx:id="modalAddSupplier" style="-fx-background-color: rgba(0,0,0,0.6);" visible="false" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <children>
            <VBox maxHeight="-Infinity" maxWidth="-Infinity" prefWidth="500.0" spacing="15.0" style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 25; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.3), 20, 0, 0, 0);">
               <children>
                  <HBox alignment="CENTER_LEFT">
                     <children>
                        <Label text="🏢 Thêm Nhà Cung Cấp Mới" textFill="#8b5cf6"><font><Font name="System Bold" size="20.0" /></font></Label>
                        <Pane HBox.hgrow="ALWAYS" />
                        <Button onAction="#onBtnHideModals" style="-fx-background-color: transparent; -fx-cursor: hand;" text="✕"><font><Font size="18.0" /></font></Button>
                     </children>
                  </HBox>
                  <Separator />
                  <VBox spacing="10.0">
                     <children>
                        <Label text="Tên nhà cung cấp *" /><TextField fx:id="txtTenNccNew" prefHeight="35.0" promptText="VD: Công ty Dược Hậu Giang" />
                        <Label text="Số điện thoại liên hệ" /><TextField fx:id="txtSdtNccNew" prefHeight="35.0" promptText="VD: 0901234567" />
                        <Label text="Email" /><TextField fx:id="txtEmailNccNew" prefHeight="35.0" promptText="VD: contact@dhg.vn" />
                        <Label text="Địa chỉ" /><TextField fx:id="txtDiaChiNccNew" prefHeight="35.0" promptText="VD: 288 Bis Nguyễn Văn Cừ, Cần Thơ" />
                     </children>
                  </VBox>
                  <HBox alignment="CENTER_RIGHT" spacing="10.0" style="-fx-padding: 10 0 0 0;">
                     <children>
                        <Button onAction="#onBtnHideModals" prefHeight="40.0" style="-fx-background-color: white; -fx-border-color: #e2e8f0; -fx-cursor: hand;" text="Hủy bỏ" />
                        <Button onAction="#onBtnSubmitAddSupplier" prefHeight="40.0" style="-fx-background-color: #8b5cf6; -fx-text-fill: white; -fx-background-radius: 8; -fx-cursor: hand; -fx-font-weight: bold;" text="Lưu Nhà Cung Cấp" />
                     </children>
                  </HBox>
               </children>
            </VBox>
         </children>
      </StackPane>

   </children>
</AnchorPane>
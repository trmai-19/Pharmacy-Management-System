<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="850.0" prefWidth="1200.0" style="-fx-background-color: transparent;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.pharmacy.controller.admin.ProductManagerController">
   <children>
      <VBox layoutX="45.0" layoutY="25.0" spacing="25.0" AnchorPane.bottomAnchor="24.59999999999991" AnchorPane.leftAnchor="45.0" AnchorPane.rightAnchor="25.40000000000009" AnchorPane.topAnchor="25.0">
         <children>
            
            <HBox spacing="25.0">
               <children>
                  <VBox prefWidth="320.0" style="-fx-background-color: white; -fx-background-radius: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.06), 15, 0, 0, 5); -fx-padding: 25;" HBox.hgrow="ALWAYS">
                     <children>
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                           <Label style="-fx-font-size: 18px;">
                              <graphic>
                                 <ImageView fitHeight="55.0" fitWidth="46.0" pickOnBounds="true" preserveRatio="true">
                                    <image>
                                       <Image url="@../../../../../../../../../../../../UIT/HK4/PTTKHTTT/icon%20app/icon%20sản%20phẩm.png" />
                                    </image>
                                 </ImageView>
                              </graphic></Label>
                           <Label style="-fx-text-fill: #64748b; -fx-font-size: 14px; -fx-font-weight: 800;" text="TỔNG SẢN PHẨM KHẢ DỤNG" />
                        </HBox>
                        <Region prefHeight="12.0" />
                        <Label fx:id="lblTotalProducts" style="-fx-font-size: 40px; -fx-font-weight: 900; -fx-text-fill: #0f766e;" text="1,245" />

<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="850.0" prefWidth="1200.0" style="-fx-background-color: transparent;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.pharmacy.controller.admin.ProductManagerController">
   <children>
      <VBox spacing="20.0" AnchorPane.bottomAnchor="25.0" AnchorPane.leftAnchor="45.0" AnchorPane.rightAnchor="25.0" AnchorPane.topAnchor="25.0">
         <children>
            <HBox spacing="25.0">
               <children>
                  <VBox prefWidth="320.0" style="-fx-background-color: #A8DADC; -fx-background-radius: 15; -fx-padding: 25;" HBox.hgrow="ALWAYS">
                     <children>
                        <Label style="-fx-text-fill: #64748b; -fx-font-size: 14px; -fx-font-weight: 800;" text="TỔNG SẢN PHẨM" />
                        <Region prefHeight="10.0" />
                        <Label fx:id="lblTotalProducts" style="-fx-font-size: 35px; -fx-font-weight: 900; -fx-text-fill: #0f766e;" text="1,245" />
                     </children>
                  </VBox>
                  <VBox prefWidth="320.0" style="-fx-background-color: #FDE9B5; -fx-background-radius: 15; -fx-padding: 25;" HBox.hgrow="ALWAYS">
                     <children>
                        <Label style="-fx-text-fill: #64748b; -fx-font-size: 14px; -fx-font-weight: 800;" text="SẮP HẾT HÀNG" />
                        <Region prefHeight="10.0" />
                        <Label fx:id="lblLowStock" style="-fx-font-size: 35px; -fx-font-weight: 900; -fx-text-fill: #f59e0b;" text="18" />
                     </children>
                  </VBox>
               </children>
            </HBox>

            <TabPane style="-fx-background-color: white; -fx-background-radius: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.06), 15, 0, 0, 5);" tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">
              <tabs>
                <Tab text="QUẢN LÝ SẢN PHẨM">
                  <content>
                    <VBox spacing="15.0" style="-fx-padding: 20;">
                         <children>
                            <HBox alignment="CENTER_LEFT" spacing="10.0">
                               <children>
                                  <TextField fx:id="txtSearchProduct" prefHeight="40.0" prefWidth="250.0" promptText="Tìm tên thuốc, hoạt chất..." style="-fx-background-radius: 8; -fx-background-color: #f1f5f9;" />
                                  <ComboBox fx:id="cbCategoryFilter" prefHeight="40.0" prefWidth="180.0" promptText="Tất cả danh mục" style="-fx-background-radius: 8; -fx-background-color: #f1f5f9;" />
                                  <Region HBox.hgrow="ALWAYS" />
                                  
                                  <!-- Nút Xác nhận sửa (Ẩn mặc định) -->
                                  <Button fx:id="btnConfirmEditProduct" managed="false" onAction="#handleConfirmEditProduct" prefHeight="40.0" style="-fx-background-color: #22c55e; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8;" text="✔ Xong" visible="false" />
                                  
                                  <!-- Các nút cơ bản -->
                                  <Button fx:id="btnAddProduct" onAction="#handleAddProduct" prefHeight="40.0" style="-fx-background-color: #0f766e; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8;" text="Thêm" />
                                  <Button fx:id="btnEditProduct" onAction="#handleEditProduct" prefHeight="40.0" style="-fx-background-color: #f59e0b; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8;" text="Sửa" />
                                  <Button onAction="#handleDeleteProduct" prefHeight="40.0" style="-fx-background-color: #ef4444; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8;" text="Xóa" />
                               </children>
                            </HBox>
                            
                            <SplitPane dividerPositions="0.6" orientation="VERTICAL" VBox.vgrow="ALWAYS">
                               <items>
                                  <TableView fx:id="tableProduct">
                                    <columns>
                                      <TableColumn fx:id="colProdId" prefWidth="100" text="Mã sản phẩm" />
                                      <TableColumn fx:id="colProdName" prefWidth="200" text="Tên thương mại" />
                                      <TableColumn fx:id="colProdActive" prefWidth="200" text="Hoạt chất" />
                                      <TableColumn fx:id="colProdCat" prefWidth="150" text="Danh mục" />
                                      <TableColumn fx:id="colProdUnit" prefWidth="100" text="Đơn vị tính" />
                                      <TableColumn fx:id="colProdQty" prefWidth="100" text="Tổng tồn kho" />
                                    </columns>
                                     <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY" /></columnResizePolicy>
                                  </TableView>
                                  
                                  <VBox spacing="10.0" style="-fx-padding: 10 0 0 0;">
                                     <children>
                                        <Label style="-fx-font-weight: bold; -fx-text-fill: #0f766e;" text="CHI TIẾT LÔ HÀNG NHẬP" />
                                        <TableView fx:id="tableBatch" VBox.vgrow="ALWAYS">
                                          <columns>
                                            <TableColumn fx:id="colBatchId" text="Mã lô nhập" />
                                            <TableColumn fx:id="colBatchMfg" text="Ngày sản xuất" />
                                            <TableColumn fx:id="colBatchExp" text="Hạn sử dụng" />
                                            <TableColumn fx:id="colBatchImport" text="Ngày nhập" />
                                            <TableColumn fx:id="colBatchQty" text="Số lượng hiện tại" />
                                            <TableColumn fx:id="colBatchStatus" text="Tình trạng" />
                                          </columns>
                                           <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY" /></columnResizePolicy>
                                        </TableView>
                                     </children>
                                  </VBox>
                               </items>
                            </SplitPane>
                         </children>
                      </VBox>
                  </content>
                </Tab>

                <Tab text="QUẢN LÝ DANH MỤC">
                  <content>
                    <VBox spacing="15.0" style="-fx-padding: 20;">
                         <children>
                            <HBox alignment="CENTER_LEFT" spacing="10.0">
                               <children>
                                  <TextField fx:id="txtSearchCategory" prefHeight="40.0" prefWidth="300.0" promptText="Tìm tên danh mục..." style="-fx-background-radius: 8; -fx-background-color: #f1f5f9;" />
                                  <Region HBox.hgrow="ALWAYS" />
                                  
                                  <Button fx:id="btnConfirmEditCategory" managed="false" onAction="#handleConfirmEditCategory" prefHeight="40.0" style="-fx-background-color: #22c55e; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8;" text="✔ Xong" visible="false" />
                                  
                                  <Button fx:id="btnAddCategory" onAction="#handleAddCategory" prefHeight="40.0" style="-fx-background-color: #0f766e; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8;" text="Thêm" />
                                  <Button fx:id="btnEditCategory" onAction="#handleEditCategory" prefHeight="40.0" style="-fx-background-color: #f59e0b; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8;" text="Sửa" />
                                  <Button onAction="#handleDeleteCategory" prefHeight="40.0" style="-fx-background-color: #ef4444; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8;" text="Xóa" />
                               </children>
                            </HBox>
                            
                            <TableView fx:id="tableCategory" VBox.vgrow="ALWAYS">
                              <columns>
                                <TableColumn fx:id="colCatId" prefWidth="150" text="Mã danh mục" />
                                <TableColumn fx:id="colCatName" prefWidth="300" text="Tên danh mục" />
                                <TableColumn fx:id="colCatNote" prefWidth="400" text="Ghi chú" />
                              </columns>
                               <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY" /></columnResizePolicy>
                            </TableView>
                         </children>
                      </VBox>
                  </content>
                </Tab>
              </tabs>
            </TabPane>
         </children>
      </VBox>
   </children>
</AnchorPane>
                        <Label fx:id="lblExpiring" style="-fx-font-size: 40px; -fx-font-weight: 900; -fx-text-fill: #ef4444;" text="5" />
                     </children>
                  </VBox>
               </children>
            </HBox>

            <VBox style="-fx-background-color: white; -fx-background-radius: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.06), 15, 0, 0, 5);" VBox.vgrow="ALWAYS">

                      <TableColumn fx:id="colStatus" prefWidth="130.0" style="-fx-alignment: CENTER; -fx-font-weight: bold;" text="Tình Trạng" />
                    </columns>
                     <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                     </columnResizePolicy>

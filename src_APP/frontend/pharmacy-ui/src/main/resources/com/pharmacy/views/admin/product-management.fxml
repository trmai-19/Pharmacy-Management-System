                     </VBox.margin>
                  </HBox>

                  <TableView fx:id="tableProduct" style="-fx-font-size: 14px; -fx-selection-bar: #ccfbf1; -fx-background-color: white; -fx-border-color: #e2e8f0; -fx-border-radius: 8;" VBox.vgrow="ALWAYS">
                    <columns>
                      <TableColumn fx:id="colId" prefWidth="90.0" style="-fx-alignment: CENTER;" text="Mã Thuốc" />

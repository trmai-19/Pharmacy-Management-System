<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="700.0" prefWidth="950.0" style="-fx-background-color: transparent;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.pharmacy.controller.admin.AddEmployeeController">
   <children>
      <VBox alignment="CENTER" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <children>
            
            <VBox maxWidth="550.0" style="-fx-background-color: white; -fx-background-radius: 12; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 20, 0, 0, 5); -fx-padding: 0;">
               <children>
                  
                  <HBox alignment="CENTER_LEFT" style="-fx-background-color: #f8fafc; -fx-background-radius: 12 12 0 0; -fx-border-color: #e2e8f0; -fx-border-width: 0 0 1 0; -fx-padding: 25 35;">
                     <children>
                        <VBox spacing="3.0">
                           <Label style="-fx-font-size: 24px; -fx-font-weight: 900; -fx-text-fill: #0f766e;" text="            CẤP TÀI KHOẢN HỆ THỐNG" />
                           <Label style="-fx-text-fill: #64748b; -fx-font-size: 14px;" text="                                    Cấp tài khoản cho nhân sự mới" />
                        </VBox>
                     </children>
                  </HBox>

                  <VBox spacing="20.0" style="-fx-padding: 35;">
                     <children>
                        
                        <VBox spacing="8.0">
                           <Label style="-fx-text-fill: #475569; -fx-font-weight: bold; -fx-font-size: 14px;" text="Số điện thoại liên lạc (*)" />
                           <TextField fx:id="txtPhone" promptText="Nhập số điện thoại nhân viên..." style="-fx-padding: 12; -fx-background-color: #f8fafc; -fx-border-color: #cbd5e1; -fx-border-radius: 6; -fx-font-size: 14px;" />
                        </VBox>

                        <VBox spacing="8.0">
                           <Label style="-fx-text-fill: #475569; -fx-font-weight: bold; -fx-font-size: 14px;" text="Email (*)" />
                           <TextField fx:id="txtEmail" promptText="Mật khẩu mặc định sẽ được gửi về email này..." style="-fx-padding: 12; -fx-background-color: #f8fafc; -fx-border-color: #cbd5e1; -fx-border-radius: 6; -fx-font-size: 14px;" />
                        </VBox>

                        <VBox spacing="8.0">
                           <Label style="-fx-text-fill: #475569; -fx-font-weight: bold; -fx-font-size: 14px;" text="Phân quyền hệ thống (*)" />
                           <ComboBox fx:id="cbRole" maxWidth="Infinity" promptText="-- Chọn quyền hạn --" style="-fx-padding: 8; -fx-background-color: #f8fafc; -fx-border-color: #cbd5e1; -fx-border-radius: 6; -fx-font-size: 14px;" />
                        </VBox>

                     </children>
                  </VBox>

                  <HBox alignment="CENTER_RIGHT" spacing="15.0" style="-fx-background-color: #f8fafc; -fx-background-radius: 0 0 12 12; -fx-border-color: #e2e8f0; -fx-border-width: 1 0 0 0; -fx-padding: 20 35;">
                     <children>
                        <Button fx:id="btnCancel" onAction="#handleCancel" prefHeight="45.0" style="-fx-background-color: transparent; -fx-text-fill: #64748b; -fx-font-weight: bold; -fx-border-color: #cbd5e1; -fx-border-radius: 6; -fx-cursor: hand; -fx-padding: 0 25; -fx-font-size: 14px;" text="HỦY BỎ" />
                        <Button fx:id="btnSubmit" onAction="#handleIssueAccount" prefHeight="45.0" style="-fx-background-color: #0f766e; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand; -fx-padding: 0 35; -fx-font-size: 14px;" text=" CẤP TÀI KHOẢN" />
                     </children>
                  </HBox>

               </children>
            </VBox>
         </children>
      </VBox>
   </children>
</AnchorPane>
                        <Label style="-fx-font-size: 42px; -fx-text-fill: #14b8a6;" text="💊" />
                        <VBox alignment="CENTER_LEFT" spacing="3.0">
                            <Label style="-fx-font-size: 18px; -fx-font-weight: 900; -fx-text-fill: #0f172a;" text="SẢN PHẨM" />

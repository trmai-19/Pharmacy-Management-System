<ScrollPane fitToWidth="true" style="-fx-background-color: #f8fafc; -fx-background: transparent;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.pharmacy.controller.admin.DashboardController">

                    <HBox alignment="CENTER_LEFT" spacing="18.0">
                        <Label style="-fx-font-size: 42px; -fx-text-fill: #0ea5e9;" text="🎧" />
                        <VBox alignment="CENTER_LEFT" spacing="3.0">
                            <Label style="-fx-font-size: 18px; -fx-font-weight: 900; -fx-text-fill: #0f172a;" text="HỖ TRỢ KỸ THUẬT" />
                            <Label style="-fx-font-size: 13px; -fx-text-fill: #64748b;" text="Báo lỗi app &amp; Hỗ trợ từ Dev" />

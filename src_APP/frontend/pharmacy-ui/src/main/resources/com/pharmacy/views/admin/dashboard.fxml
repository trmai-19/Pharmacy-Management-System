            <Region VBox.vgrow="ALWAYS" /> <VBox alignment="CENTER" spacing="6.0" style="-fx-padding: 30 0 10 0; -fx-border-color: #e2e8f0; -fx-border-width: 1 0 0 0; -fx-margin-top: 20px;">

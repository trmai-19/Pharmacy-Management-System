                    <ColumnConstraints hgrow="ALWAYS" percentWidth="33.33" />
                </columnConstraints>
                
                <VBox fx:id="cardProduct" onMouseClicked="#goToProduct" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 22; -fx-border-color: #14b8a6; -fx-border-width: 0 0 0 6; -fx-cursor: hand; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.06), 10, 0, 0, 5);" GridPane.columnIndex="0" GridPane.rowIndex="0">

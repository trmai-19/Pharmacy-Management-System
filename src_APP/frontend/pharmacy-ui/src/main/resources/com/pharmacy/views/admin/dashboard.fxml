                    </HBox>
                </VBox>

                <VBox fx:id="cardReport" onMouseClicked="#goToReport" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 22; -fx-border-color: #f43f5e; -fx-border-width: 0 0 0 6; -fx-cursor: hand; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.06), 10, 0, 0, 5);" GridPane.columnIndex="2" GridPane.rowIndex="1">

                <Label text="Bản quyền © 2026 phát triển bởi Nhóm HMPP. Tất cả các quyền được bảo lưu." style="-fx-text-fill: #64748b; -fx-font-size: 13px;" />
                <HBox alignment="CENTER" spacing="15.0" style="-fx-padding: 5 0 0 0;">
                    <Label text="Phiên bản: 2.0.1 Enterprise" style="-fx-text-fill: #94a3b8; -fx-font-size: 12px;" />
                    <Label text="|" style="-fx-text-fill: #cbd5e1;" />
                    <Label text="Email: support@hmpp.vn" style="-fx-text-fill: #94a3b8; -fx-font-size: 12px;" />
                    <Label text="|" style="-fx-text-fill: #cbd5e1;" />
                    <Label text="Hotline: 1900 8888" style="-fx-text-fill: #94a3b8; -fx-font-size: 12px;" />

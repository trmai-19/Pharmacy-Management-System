                    </HBox>
                </VBox>
                
                <VBox fx:id="cardEmployee" onMouseClicked="#goToEmployee" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 22; -fx-border-color: #3b82f6; -fx-border-width: 0 0 0 6; -fx-cursor: hand; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.06), 10, 0, 0, 5);" GridPane.columnIndex="1" GridPane.rowIndex="0">

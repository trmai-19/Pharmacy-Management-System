<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="768.0" prefWidth="1024.0" style="-fx-background-color: transparent;" xmlns="http://javafx.com/javafx/19" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.pharmacy.controller.admin.ReturnManagerController">
    <children>
        <VBox spacing="20.0" AnchorPane.bottomAnchor="20.0" AnchorPane.leftAnchor="30.0" AnchorPane.rightAnchor="30.0" AnchorPane.topAnchor="30.0">
            <children>
                <HBox alignment="CENTER_LEFT" spacing="15.0">
                    <children>
                        <VBox alignment="CENTER" style="-fx-background-color: #e0f2f1; -fx-background-radius: 10; -fx-min-width: 50; -fx-min-height: 50;">
                            <Label text="" textFill="#0d94aa"><font><Font name="System Bold" size="24.0" /></font></Label>
                        </VBox>
                        <VBox HBox.hgrow="ALWAYS">
                            <children>
                                <!-- ĐÃ SỬA LỖI Ở ĐÂY: Thêm thẻ mở Label -->
                                <Label text="" textFill="#334155">
                                    <font><Font name="System Bold" size="24.0" /></font>
                                </Label>
                            </children>
                        </VBox>
                        <!-- Đã xóa 2 nút Khách trả hàng và Trả hàng NCC ở đây -->
                    </children>
                </HBox>

                <VBox style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 0);" VBox.vgrow="ALWAYS">
                    <children>
                        <HBox alignment="CENTER_LEFT" spacing="15.0">
                            <children>
                                <TextField fx:id="txtSearch" prefHeight="40.0" prefWidth="400.0" promptText="🔍 Tìm mã phiếu đổi trả, mã lô, tên SP..." style="-fx-background-radius: 8;" />
                                <ComboBox fx:id="cbFilterStatus" prefHeight="40.0" prefWidth="200.0" promptText="Tất cả trạng thái" />
                            </children>
                            <VBox.margin><Insets bottom="15.0" /></VBox.margin>
                        </HBox>

                        <TableView fx:id="tableReturn" style="-fx-border-color: transparent;" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="colTicketId" prefWidth="90.0" style="-fx-font-weight: bold;" text="Mã Phiếu" />
                                <TableColumn fx:id="colDate" prefWidth="100.0" text="Ngày tạo" />
                                <TableColumn fx:id="colPartner" prefWidth="180.0" style="-fx-font-weight: bold;" text="Đối tác" />
                                <TableColumn fx:id="colReference" prefWidth="120.0" text="Mã Lô / Hóa Đơn" />
                                <TableColumn fx:id="colProduct" prefWidth="180.0" text="Sản phẩm" />
                                <TableColumn fx:id="colQuantity" prefWidth="80.0" text="SL Trả" />
                                <TableColumn fx:id="colReason" prefWidth="150.0" text="Lý do" />
                            </columns>
                            <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY" /></columnResizePolicy>
                        </TableView>
                    </children>
                </VBox>
            </children>
        </VBox>

        <Pane fx:id="modalReturnNCC" visible="false" style="-fx-background-color: rgba(0,0,0,0.6);" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <children>
                <VBox layoutX="262.0" layoutY="100.0" prefWidth="500.0" spacing="15.0" style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 30; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.2), 20, 0, 0, 10);">
                    <children>
                        <HBox alignment="CENTER_LEFT">
                            <children>
                                <Label text="⚠ Tạo Phiếu Trả Hàng NCC" textFill="#F26822"><font><Font name="System Bold" size="20.0" /></font></Label>
                                <Pane HBox.hgrow="ALWAYS" />
                                <Button onAction="#onBtnHideModals" style="-fx-background-color: transparent; -fx-cursor: hand;" text="✕" textFill="#94a3b8"><font><Font size="18.0" /></font></Button>
                            </children>
                        </HBox>
                        
                        <VBox spacing="8.0"><children><Label text="Nhà cung cấp *" /><ComboBox fx:id="cbSupplier" prefHeight="40.0" prefWidth="440.0" promptText="-- Chọn nhà cung cấp --" /></children></VBox>
                        <VBox spacing="8.0"><children><Label text="Tên sản phẩm *" /><TextField fx:id="txtProductNameNCC" prefHeight="40.0" promptText="Nhập tên sản phẩm..." /></children></VBox>
                        
                        <HBox spacing="15.0">
                            <children>
                                <VBox spacing="8.0" HBox.hgrow="ALWAYS"><children><Label text="Mã lô (Batch No.) *" /><TextField fx:id="txtBatchNo" prefHeight="40.0" promptText="Nhập mã lô..." /></children></VBox>
                                <VBox spacing="8.0" HBox.hgrow="ALWAYS"><children><Label text="Số lượng trả *" /><TextField fx:id="txtReturnQtyNCC" prefHeight="40.0" promptText="0" /></children></VBox>
                            </children>
                        </HBox>
                        
                        <VBox spacing="8.0"><children><Label text="Lý do trả hàng *" /><TextArea fx:id="txtReasonNCC" prefHeight="80.0" promptText="Ví dụ: Hàng cận date, bao bì móp méo..." /></children></VBox>
                        
                        <HBox alignment="CENTER_RIGHT" spacing="15.0">
                            <children>
                                <Button onAction="#onBtnHideModals" style="-fx-background-color: transparent; -fx-cursor: hand;" text="Hủy bỏ" textFill="#64748b"><font><Font name="System Bold" size="14.0" /></font></Button>
                                <Button onAction="#onBtnSubmitReturnNCC" prefHeight="45.0" style="-fx-background-color: #F26822; -fx-text-fill: white; -fx-background-radius: 8; -fx-padding: 0 20; -fx-cursor: hand;" text="Tạo phiếu trả NCC"><font><Font name="System Bold" size="14.0" /></font></Button>
                            </children>
                            <padding><Insets top="10.0" /></padding>
                        </HBox>
                    </children>
                </VBox>
            </children>
        </Pane>

        <Pane fx:id="modalReturnCustomer" visible="false" style="-fx-background-color: rgba(0,0,0,0.6);" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <children>
                <VBox layoutX="262.0" layoutY="100.0" prefWidth="500.0" spacing="15.0" style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 30; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.2), 20, 0, 0, 10);">
                    <children>
                        <HBox alignment="CENTER_LEFT">
                            <children>
                                <Label text="↩ Phiếu Khách Trả Hàng" textFill="#0d94aa"><font><Font name="System Bold" size="20.0" /></font></Label>
                                <Pane HBox.hgrow="ALWAYS" />
                                <Button onAction="#onBtnHideModals" style="-fx-background-color: transparent; -fx-cursor: hand;" text="✕" textFill="#94a3b8"><font><Font size="18.0" /></font></Button>
                            </children>
                        </HBox>
                        
                        <VBox spacing="8.0">
                            <children>
                                <Label text="Mã hóa đơn gốc *" />
                                <TextField fx:id="txtInvoiceNo" prefHeight="40.0" promptText="🔍 VD: HD-20240418-001" />
                                <Label text="Hệ thống sẽ tự động tải thông tin sản phẩm từ hóa đơn." textFill="#94a3b8"><font><Font size="11.0" /></font></Label>
                            </children>
                        </VBox>
                        
                        <VBox spacing="8.0"><children><Label text="Sản phẩm trả lại *" /><ComboBox fx:id="cbProductCustomer" prefHeight="40.0" prefWidth="440.0" promptText="-- Chọn sản phẩm từ hóa đơn --" /></children></VBox>
                        
                        <HBox spacing="15.0">
                            <children>
                                <VBox spacing="8.0" HBox.hgrow="ALWAYS"><children><Label text="Số lượng trả *" /><TextField fx:id="txtReturnQtyCustomer" prefHeight="40.0" promptText="1" /></children></VBox>
                                <VBox spacing="8.0" HBox.hgrow="ALWAYS"><children><Label text="Số tiền hoàn (VNĐ) *" /><TextField fx:id="txtRefundAmount" prefHeight="40.0" promptText="0 đ" style="-fx-text-fill: #0d94aa; -fx-font-weight: bold;" /></children></VBox>
                            </children>
                        </HBox>
                        
                        <VBox spacing="8.0"><children><Label text="Lý do khách trả *" /><TextArea fx:id="txtReasonCustomer" prefHeight="80.0" promptText="Ví dụ: Khách mua nhầm loại..." /></children></VBox>
                        
                        <HBox alignment="CENTER_RIGHT" spacing="15.0">
                            <children>
                                <Button onAction="#onBtnHideModals" style="-fx-background-color: transparent; -fx-cursor: hand;" text="Hủy bỏ" textFill="#64748b"><font><Font name="System Bold" size="14.0" /></font></Button>
                                <Button onAction="#onBtnSubmitReturnCustomer" prefHeight="45.0" style="-fx-background-color: #0d94aa; -fx-text-fill: white; -fx-background-radius: 8; -fx-padding: 0 20; -fx-cursor: hand;" text="Hoàn tiền &amp; Nhập lại kho"><font><Font name="System Bold" size="14.0" /></font></Button>
                            </children>
                            <padding><Insets top="10.0" /></padding>
                        </HBox>
                    </children>
                </VBox>
            </children>
        </Pane>
    </children>
</AnchorPane>
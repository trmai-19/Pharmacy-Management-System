<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="800.0" prefWidth="1200.0" style="-fx-background-color: #f4f6f9;" xmlns="http://javafx.com/javafx/19" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.pharmacy.controller.admin.ReturnManagerController">
    <children>
        <VBox spacing="15.0" AnchorPane.bottomAnchor="20.0" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="20.0">
            <children>
                <TabPane fx:id="mainTabPane" tabClosingPolicy="UNAVAILABLE" style="-fx-background-color: white; -fx-background-radius: 10;">
                    <Tab text="🛒 Đổi trả khách hàng" closable="false">
                        <content>
                            <VBox spacing="15.0" style="-fx-padding: 20; -fx-background-color: white;">
                                <children>
                                    <HBox alignment="CENTER_LEFT" spacing="15.0">
                                        <TextField fx:id="salesTxtSearchInvoice" promptText="🔍 Tìm mã hóa đơn, SĐT khách..." prefHeight="40.0" HBox.hgrow="ALWAYS" style="-fx-background-color: #f1f5f9; -fx-background-radius: 6; -fx-padding: 0 10;" />
                                        <Button text="Tìm" onAction="#handleSalesFetchInvoices" style="-fx-background-color: #e2e8f0; -fx-cursor: hand; -fx-background-radius: 6;" />
                                    </HBox>

                                    <SplitPane orientation="VERTICAL" dividerPositions="0.55" VBox.vgrow="ALWAYS" style="-fx-background-color: transparent; -fx-box-border: transparent;">
                                        <items>
                                            <VBox spacing="10.0" style="-fx-background-color: white; -fx-padding: 0 0 10 0;">
                                                <Label text="📋 DANH SÁCH HÓA ĐƠN BÁN HÀNG (Chọn 1 hóa đơn)" style="-fx-font-weight: bold; -fx-text-fill: #0f766e;" />
                                                <TableView fx:id="salesTableInvoices" VBox.vgrow="ALWAYS" style="-fx-border-color: #e2e8f0; -fx-border-radius: 6;">
                                                    <columns>
                                                        <TableColumn fx:id="salesColInvId" prefWidth="100.0" text="Mã HĐ" />
                                                        <TableColumn fx:id="salesColInvDate" prefWidth="130.0" text="Ngày Bán" />
                                                        <TableColumn fx:id="salesColInvCustomer" prefWidth="250.0" text="Khách Hàng" />
                                                        <TableColumn fx:id="salesColInvTotal" prefWidth="120.0" text="Tổng Tiền" />
                                                        <TableColumn fx:id="salesColInvPoints" prefWidth="80.0" text="Điểm SD" />
                                                        <TableColumn fx:id="salesColInvStatus" prefWidth="100.0" text="Trạng Thái" />
                                                        <TableColumn fx:id="salesColInvAction" prefWidth="60.0" text="Chi tiết" />
                                                    </columns>
                                                    <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                                                </TableView>
                                            </VBox>
                                            <VBox spacing="10.0" style="-fx-background-color: white; -fx-padding: 10 0 0 0;">
                                                <Label fx:id="salesLblReturnHistoryTitle" text="📜 LỊCH SỬ TRẢ HÀNG CỦA HÓA ĐƠN: (Chưa chọn)" style="-fx-font-weight: bold; -fx-text-fill: #dc2626;" />
                                                <TableView fx:id="salesTableReturns" VBox.vgrow="ALWAYS" style="-fx-border-color: #e2e8f0; -fx-border-radius: 6;">
                                                    <columns>
                                                        <TableColumn fx:id="salesColRetId" prefWidth="120.0" text="Mã Phiếu" />
                                                        <TableColumn fx:id="salesColRetDate" prefWidth="140.0" text="Ngày Trả" />
                                                        <TableColumn fx:id="salesColRetReason" prefWidth="250.0" text="Lý do trả" />
                                                        <TableColumn fx:id="salesColRetTotal" prefWidth="130.0" text="Tổng Tiền Hoàn" />
                                                        <TableColumn fx:id="salesColRetPoints" prefWidth="90.0" text="Điểm Hoàn" />
                                                        <TableColumn fx:id="salesColRetAction" prefWidth="60.0" text="Chi tiết" />
                                                    </columns>
                                                    <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                                                </TableView>
                                            </VBox>
                                        </items>
                                    </SplitPane>
                                </children>
                            </VBox>
                        </content>
                    </Tab>

                    <Tab text="🏭 Đổi trả nhà cung cấp" closable="false">
                        <content>
                            <VBox spacing="15.0" style="-fx-padding: 20; -fx-background-color: white;">
                                <children>
                                    <HBox alignment="CENTER_LEFT" spacing="15.0">
                                        <TextField fx:id="warehouseTxtSearchImport" promptText="🔍 Tìm mã phiếu nhập..." prefHeight="40.0" HBox.hgrow="ALWAYS" style="-fx-background-color: #f1f5f9; -fx-background-radius: 6; -fx-padding: 0 10;" />
                                        <Button text="Tìm" onAction="#handleWarehouseLoadImportReceipts" style="-fx-background-color: #e2e8f0; -fx-cursor: hand; -fx-background-radius: 6;" />
                                    </HBox>

                                    <SplitPane orientation="VERTICAL" dividerPositions="0.55" VBox.vgrow="ALWAYS" style="-fx-background-color: transparent; -fx-box-border: transparent;">
                                        <items>
                                            <VBox spacing="10.0" style="-fx-background-color: white; -fx-padding: 0 0 10 0;">
                                                <Label text="📦 DANH SÁCH PHIẾU NHẬP (Chọn 1 phiếu)" style="-fx-font-weight: bold; -fx-text-fill: #0f766e;" />
                                                <TableView fx:id="warehouseTableImportReceipts" VBox.vgrow="ALWAYS" style="-fx-border-color: #e2e8f0; -fx-border-radius: 6;">
                                                    <columns>
                                                        <TableColumn fx:id="warehouseColImpId" prefWidth="110.0" text="Mã Phiếu Nhập" />
                                                        <TableColumn fx:id="warehouseColImpDate" prefWidth="100.0" text="Ngày Nhập" />
                                                        <TableColumn fx:id="warehouseColImpNcc" prefWidth="200.0" text="Nhà Cung Cấp" />
                                                        <TableColumn fx:id="warehouseColImpTotal" prefWidth="130.0" text="Tổng Tiền" />
                                                        <TableColumn fx:id="warehouseColImpStatus" prefWidth="100.0" text="Trạng Thái" />
                                                        <TableColumn fx:id="warehouseColImpActionView" prefWidth="60.0" text="Chi tiết" />
                                                    </columns>
                                                    <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                                                </TableView>
                                            </VBox>
                                            <VBox spacing="10.0" style="-fx-background-color: white; -fx-padding: 10 0 0 0;">
                                                <Label fx:id="warehouseLblDetailReturn" text="📑 LỊCH SỬ TRẢ HÀNG CỦA PHIẾU: ..." style="-fx-font-weight: bold; -fx-text-fill: #c2410c;" />
                                                <TableView fx:id="warehouseTableReturns" VBox.vgrow="ALWAYS" style="-fx-border-color: #e2e8f0; -fx-border-radius: 6;">
                                                    <columns>
                                                        <TableColumn fx:id="warehouseColRetId" prefWidth="120.0" text="Mã Phiếu Trả" />
                                                        <TableColumn fx:id="warehouseColRetDate" prefWidth="110.0" text="Ngày Trả" />
                                                        <TableColumn fx:id="warehouseColRetReason" prefWidth="250.0" text="Lý do" />
                                                        <TableColumn fx:id="warehouseColRetTotal" prefWidth="130.0" text="Tổng Tiền Trả" />
                                                        <TableColumn fx:id="warehouseColRetActionView" prefWidth="60.0" text="Chi tiết" />
                                                    </columns>
                                                    <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                                                </TableView>
                                            </VBox>
                                        </items>
                                    </SplitPane>
                                </children>
                            </VBox>
                        </content>
                    </Tab>
                </TabPane>
            </children>
        </VBox>

        <StackPane fx:id="salesModalInvoiceDetail" visible="false" alignment="CENTER" style="-fx-background-color: rgba(0,0,0,0.6);" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <VBox maxWidth="800.0" maxHeight="500.0" spacing="15.0" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 25;">
                <HBox alignment="CENTER_LEFT">
                    <Label fx:id="salesLblInvoiceDetailTitle" text="Chi tiết Hóa Đơn: ..." style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #09736a;" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Button text="✕" onAction="#handleSalesCloseInvoiceDetailModal" style="-fx-background-color: transparent; -fx-cursor: hand; -fx-font-size: 18px;"/>
                </HBox>
                <TableView fx:id="salesTableInvoiceDetails" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="salesColInvDetTen" prefWidth="250.0" text="Sản Phẩm" />
                        <TableColumn fx:id="salesColInvDetMalo" prefWidth="120.0" text="Mã Lô" />
                        <TableColumn fx:id="salesColInvDetSl" prefWidth="80.0" text="SL" />
                        <TableColumn fx:id="salesColInvDetGia" prefWidth="120.0" text="Đơn Giá" />
                        <TableColumn fx:id="salesColInvDetTong" prefWidth="150.0" text="Thành Tiền" />
                    </columns>
                    <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                </TableView>
            </VBox>
        </StackPane>

        <StackPane fx:id="salesModalReturnDetail" visible="false" alignment="CENTER" style="-fx-background-color: rgba(0,0,0,0.6);" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <VBox maxWidth="800.0" maxHeight="500.0" spacing="15.0" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 25;">
                <HBox alignment="CENTER_LEFT">
                    <Label fx:id="salesLblReturnDetailTitle" text="Chi tiết Phiếu Trả: ..." style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #dc2626;" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Button text="✕" onAction="#handleSalesCloseReturnDetailModal" style="-fx-background-color: transparent; -fx-cursor: hand; -fx-font-size: 18px;"/>
                </HBox>
                <TableView fx:id="salesTableReturnDetails" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="salesColRetDetTen" prefWidth="250.0" text="Sản Phẩm" />
                        <TableColumn fx:id="salesColRetDetMalo" prefWidth="120.0" text="Mã Lô" />
                        <TableColumn fx:id="salesColRetDetSl" prefWidth="80.0" text="SL Trả" />
                        <TableColumn fx:id="salesColRetDetGia" prefWidth="120.0" text="Đơn Giá Hoàn" />
                        <TableColumn fx:id="salesColRetDetTong" prefWidth="150.0" text="Thành Tiền" />
                    </columns>
                    <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                </TableView>
            </VBox>
        </StackPane>

        <Pane fx:id="warehouseModalViewImport" visible="false" style="-fx-background-color: rgba(0,0,0,0.6);" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <VBox layoutX="162.0" layoutY="120.0" prefWidth="750.0" spacing="15.0" style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 30;">
                <HBox alignment="CENTER_LEFT">
                    <Label text="📋 Chi Tiết Phiếu Nhập Kho" textFill="#0f766e" style="-fx-font-weight: bold; -fx-font-size: 20px;" />
                    <Pane HBox.hgrow="ALWAYS" />
                    <Button onAction="#handleWarehouseHideModals" text="✕" style="-fx-background-color: transparent; -fx-cursor: hand; -fx-font-size: 18px;" />
                </HBox>
                <Separator />
                <VBox spacing="8.0">
                    <HBox><Label text="Mã phiếu: " style="-fx-font-weight: bold;"/><Label fx:id="warehouseLblViewImpId" text="..." /></HBox>
                    <HBox><Label text="Ngày nhập: " style="-fx-font-weight: bold;"/><Label fx:id="warehouseLblViewImpDate" text="..." /></HBox>
                    <HBox><Label text="Nhà CC: " style="-fx-font-weight: bold;"/><Label fx:id="warehouseLblViewImpNcc" text="..." /></HBox>
                </VBox>
                <TableView fx:id="warehouseTableViewImportItems" prefHeight="200.0" style="-fx-border-color: #e2e8f0; -fx-border-radius: 5;">
                    <columns>
                        <TableColumn fx:id="warehouseColViewImpProductName" prefWidth="180.0" text="Tên Sản Phẩm" />
                        <TableColumn fx:id="warehouseColViewImpMalo" prefWidth="120.0" text="Mã Lô Nhập" />
                        <TableColumn fx:id="warehouseColViewImpQty" prefWidth="80.0" style="-fx-alignment: CENTER;" text="Số Lượng" />
                        <TableColumn fx:id="warehouseColViewImpPrice" prefWidth="150.0" style="-fx-alignment: CENTER_RIGHT;" text="Giá Nhập (VNĐ)" />
                        <TableColumn fx:id="warehouseColViewImpTotal" prefWidth="150.0" style="-fx-alignment: CENTER_RIGHT;" text="Thành Tiền" />
                    </columns>
                    <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                </TableView>
                <HBox alignment="CENTER_RIGHT">
                    <Label text="Tổng tiền: " style="-fx-font-weight: bold; -fx-font-size: 16px;"/>
                    <Label fx:id="warehouseLblViewImpTotal" text="0 VNĐ" textFill="#dc2626" style="-fx-font-weight: bold; -fx-font-size: 16px;" />
                </HBox>
            </VBox>
        </Pane>

        <Pane fx:id="warehouseModalViewReturn" visible="false" style="-fx-background-color: rgba(0,0,0,0.6);" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <VBox layoutX="162.0" layoutY="120.0" prefWidth="750.0" spacing="15.0" style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 30;">
                <HBox alignment="CENTER_LEFT">
                    <Label text="Biên Lai Trả Hàng Nhà Cung Cấp" textFill="#c2410c" style="-fx-font-weight: bold; -fx-font-size: 20px;" />
                    <Pane HBox.hgrow="ALWAYS" />
                    <Button onAction="#handleWarehouseHideModals" text="✕" style="-fx-background-color: transparent; -fx-cursor: hand; -fx-font-size: 18px;" />
                </HBox>
                <Separator />
                <HBox spacing="40.0">
                    <VBox spacing="8.0">
                        <HBox><Label text="Mã phiếu trả: " style="-fx-font-weight: bold;"/><Label fx:id="warehouseLblViewRetId" text="..." /></HBox>
                        <HBox><Label text="Phiếu nhập gốc: " style="-fx-font-weight: bold;"/><Label fx:id="warehouseLblViewRetOriginalId" text="..." /></HBox>
                    </VBox>
                    <VBox spacing="8.0">
                        <HBox><Label text="Ngày trả: " style="-fx-font-weight: bold;"/><Label fx:id="warehouseLblViewRetDate" text="..." /></HBox>
                        <HBox><Label text="Lý do: " style="-fx-font-weight: bold;"/><Label fx:id="warehouseLblViewRetReason" text="..." /></HBox>
                    </VBox>
                </HBox>
                <TableView fx:id="warehouseTableViewReturnItems" prefHeight="200.0" style="-fx-border-color: #e2e8f0; -fx-border-radius: 5;">
                    <columns>
                        <TableColumn fx:id="warehouseColViewRetProductName" prefWidth="180.0" text="Tên Sản Phẩm" />
                        <TableColumn fx:id="warehouseColViewRetMalo" prefWidth="120.0" text="Mã Lô Trả" />
                        <TableColumn fx:id="warehouseColViewRetQty" prefWidth="100.0" style="-fx-alignment: CENTER;" text="Số Lượng Trả" />
                        <TableColumn fx:id="warehouseColViewRetPrice" prefWidth="150.0" style="-fx-alignment: CENTER_RIGHT;" text="Đơn Giá Nhập Gốc" />
                        <TableColumn fx:id="warehouseColViewRetTotal" prefWidth="150.0" style="-fx-alignment: CENTER_RIGHT;" text="Thành Tiền" />
                    </columns>
                    <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                </TableView>
                <HBox alignment="CENTER_RIGHT">
                    <Label text="Tổng giá trị xuất trả: " style="-fx-font-weight: bold; -fx-font-size: 16px;"/>
                    <Label fx:id="warehouseLblViewRetTotal" text="0 VNĐ" textFill="#c2410c" style="-fx-font-weight: bold; -fx-font-size: 16px;" />
                </HBox>
            </VBox>
        </Pane>

    </children>
</AnchorPane>
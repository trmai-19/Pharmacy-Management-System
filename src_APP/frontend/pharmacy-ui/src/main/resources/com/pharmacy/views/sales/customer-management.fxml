<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="800.0" prefWidth="1200.0" style="-fx-background-color: transparent;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.pharmacy.controller.admin.CustomerManagerController">
   <children>
      <!-- Nội dung chính của màn hình -->
      <VBox spacing="20.0" AnchorPane.bottomAnchor="20.0" AnchorPane.leftAnchor="30.0" AnchorPane.rightAnchor="30.0" AnchorPane.topAnchor="20.0">
         <children>
            
            <!-- Cards thống kê -->
            <HBox spacing="20.0">
               <children>
                  <VBox prefWidth="300.0" style="-fx-background-color: #A8DADC; -fx-background-radius: 12; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 5); -fx-padding: 20;" HBox.hgrow="ALWAYS">
                     <children>
                        <Label style="-fx-text-fill: #64748b; -fx-font-size: 14px; -fx-font-weight: bold;" text=" TỔNG SỐ KHÁCH HÀNG" />
                        <Region prefHeight="10.0" />
                        <HBox alignment="BOTTOM_LEFT" spacing="10.0">
                           <Label fx:id="lblTotalCustomers" style="-fx-font-size: 32px; -fx-font-weight: 900; -fx-text-fill: #0f766e;" text="3,482" />
                           <Label style="-fx-text-fill: #22c55e; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 0 0 5 0;" text="↑ +124 tháng này" />
                        </HBox>
                     </children>
                  </VBox>
                  <VBox prefWidth="300.0" style="-fx-background-color: #F8C9C9; -fx-background-radius: 12; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 5); -fx-padding: 20;" HBox.hgrow="ALWAYS">
                     <children>
                        <Label style="-fx-text-fill: #64748b; -fx-font-size: 14px; -fx-font-weight: bold;" text=" KHÁCH HÀNG VIP (VÀNG/KC)" />
                        <Region prefHeight="10.0" />
                        <Label fx:id="lblVIPCustomers" style="-fx-font-size: 32px; -fx-font-weight: 900; -fx-text-fill: #eab308;" text="156" />
                     </children>
                  </VBox>
                  <VBox prefWidth="300.0" style="-fx-background-color: #FDE9B5; -fx-background-radius: 12; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 5); -fx-padding: 20;" HBox.hgrow="ALWAYS">
                     <children>
                        <Label style="-fx-text-fill: #64748b; -fx-font-size: 14px; -fx-font-weight: bold;" text="KHÁCH HÀNG THÀNH VIÊN" />
                        <Region prefHeight="10.0" />
                        <Label fx:id="lblSpecialNotes" style="-fx-font-size: 32px; -fx-font-weight: 900; -fx-text-fill: #ef4444;" text="420" />
                     </children>
                  </VBox>
               </children>
            </HBox>

            <!-- Vùng tìm kiếm, lọc và Bảng dữ liệu -->
            <VBox style="-fx-background-color: white; -fx-background-radius: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 5);" VBox.vgrow="ALWAYS">
               <padding>
                  <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
               </padding>
               <children>
                  
                  <!-- Toolbar (Search, Filter, và Nút Tạo hồ sơ) -->
                  <HBox alignment="CENTER_LEFT" prefHeight="60.0" spacing="15.0">
                     <children>
                        <HBox alignment="CENTER_LEFT" prefHeight="40.0" prefWidth="320.0" style="-fx-background-color: #f1f5f9; -fx-background-radius: 8; -fx-padding: 0 15;">
                           <children>
                              <Label style="-fx-text-fill: #64748b; -fx-font-size: 14px;" text="🔍" />
                              <TextField fx:id="txtSearch" prefHeight="35.0" promptText="Tìm SĐT, Tên khách hàng..." style="-fx-background-color: transparent; -fx-font-size: 14px;" HBox.hgrow="ALWAYS" />
                           </children>
                        </HBox>
                        
                        <ComboBox fx:id="cbTier" prefHeight="40.0" prefWidth="201.0" promptText="Tất cả hạng mức" style="-fx-background-color: #f1f5f9; -fx-background-radius: 8; -fx-font-size: 14px;" />
                        
                        <!-- Đẩy nút Tạo hồ sơ sang bên phải -->
                        <Region HBox.hgrow="ALWAYS" />
                        
                        <!-- NÚT TẠO HỒ SƠ MỚI -->
                        <Button fx:id="btnShowCreateForm" onAction="#handleShowCreateForm" prefHeight="40.0" style="-fx-background-color: #0f766e; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14px; -fx-background-radius: 8; -fx-cursor: hand;" text="+ TẠO HỒ SƠ" />
                     </children>
                     <VBox.margin>
                        <Insets bottom="15.0" />
                     </VBox.margin>
                  </HBox>

                  <TableView fx:id="tableCustomer" style="-fx-font-size: 14px; -fx-selection-bar: #ccfbf1; -fx-background-radius: 8;" VBox.vgrow="ALWAYS">
                    <columns>
                      <TableColumn fx:id="colId" prefWidth="100.0" style="-fx-alignment: CENTER;" text="Mã KH" />
                      <TableColumn fx:id="colName" prefWidth="180.0" style="-fx-font-weight: bold;" text="Họ và tên" />
                      <TableColumn fx:id="colPhone" prefWidth="120.0" style="-fx-alignment: CENTER;" text="Số điện thoại" />
                      <TableColumn fx:id="colTier" prefWidth="100.0" style="-fx-alignment: CENTER;" text="Hạng" />
                      <TableColumn fx:id="colPoints" prefWidth="90.0" style="-fx-alignment: CENTER-RIGHT;" text="Điểm TL" />
                      <TableColumn fx:id="colTotalSpent" prefWidth="120.0" style="-fx-alignment: CENTER-RIGHT; -fx-text-fill: #0f766e; -fx-font-weight: bold;" text="Tổng chi tiêu" />
                      <TableColumn fx:id="colLastVisit" prefWidth="120.0" style="-fx-alignment: CENTER;" text="Lần Mua Cuối" />
                    </columns>
                     <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                     </columnResizePolicy>
                  </TableView>
               </children>
            </VBox>
         </children>
      </VBox>

      <!-- MODAL OVERLAY: FORM TẠO HỒ SƠ (Mặc định ẩn) -->
      <!-- Đã thêm alignment="CENTER" vào StackPane -->
      <StackPane fx:id="modalOverlay" alignment="CENTER" visible="false" style="-fx-background-color: rgba(0, 0, 0, 0.4);" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <children>
            <!-- Đã thêm StackPane.alignment="CENTER" vào VBox -->
            <VBox StackPane.alignment="CENTER" maxHeight="-Infinity" maxWidth="-Infinity" prefWidth="550.0" style="-fx-background-color: #f8fafc; -fx-background-radius: 12; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.2), 20, 0, 0, 10);">
               <children>
                  
                  <!-- Form Header -->
                  <VBox alignment="CENTER" spacing="5.0" style="-fx-background-color: white; -fx-background-radius: 12 12 0 0; -fx-padding: 25; -fx-border-color: transparent transparent #e2e8f0 transparent; -fx-border-width: 0 0 1 0;">
                     <children>
                        <Label style="-fx-font-size: 24px; -fx-font-weight: 900; -fx-text-fill: #0f766e;" text="TẠO HỒ SƠ KHÁCH HÀNG" />
                        <Label style="-fx-text-fill: #64748b; -fx-font-size: 14px;" text="Tạo hồ sơ cho khách hàng mới" />
                     </children>
                  </VBox>

                  <!-- Form Body -->
                  <VBox spacing="20.0" style="-fx-background-color: white; -fx-padding: 30;">
                     <children>
                        
                        <!-- Họ và Tên -->
                        <VBox spacing="8.0">
                           <children>
                              <Label style="-fx-font-weight: bold; -fx-text-fill: #334155; -fx-font-size: 14px;" text="Họ và tên (*)" />
                              <TextField fx:id="txtNewName" prefHeight="45.0" promptText="Nhập họ và tên..." style="-fx-background-color: white; -fx-border-color: #cbd5e1; -fx-border-radius: 6; -fx-background-radius: 6; -fx-font-size: 14px;" />
                           </children>
                        </VBox>

                        <!-- Số điện thoại -->
                        <VBox spacing="8.0">
                           <children>
                              <Label style="-fx-font-weight: bold; -fx-text-fill: #334155; -fx-font-size: 14px;" text="Số điện thoại (*)" />
                              <TextField fx:id="txtNewPhone" prefHeight="45.0" promptText="Nhập số điện thoại..." style="-fx-background-color: white; -fx-border-color: #cbd5e1; -fx-border-radius: 6; -fx-background-radius: 6; -fx-font-size: 14px;" />
                           </children>
                        </VBox>

                        <!-- Giới tính và Ngày sinh -->
                        <HBox spacing="20.0">
                           <children>
                              <VBox spacing="8.0" HBox.hgrow="ALWAYS">
                                 <children>
                                    <Label style="-fx-font-weight: bold; -fx-text-fill: #334155; -fx-font-size: 14px;" text="Giới tính (*)" />
                                    <ComboBox fx:id="cbNewGender" maxWidth="1.7976931348623157E308" prefHeight="45.0" promptText="-- Chọn giới tính --" style="-fx-background-color: white; -fx-border-color: #cbd5e1; -fx-border-radius: 6; -fx-background-radius: 6; -fx-font-size: 14px;" />
                                 </children>
                              </VBox>
                              <VBox spacing="8.0" HBox.hgrow="ALWAYS">
                                 <children>
                                    <Label style="-fx-font-weight: bold; -fx-text-fill: #334155; -fx-font-size: 14px;" text="Ngày sinh (*)" />
                                    <DatePicker fx:id="dpNewDOB" maxWidth="1.7976931348623157E308" prefHeight="45.0" promptText="dd/MM/yyyy" style="-fx-background-color: white; -fx-border-color: #cbd5e1; -fx-border-radius: 6; -fx-background-radius: 6; -fx-font-size: 14px;" />
                                 </children>
                              </VBox>
                           </children>
                        </HBox>

                     </children>
                  </VBox>

                  <!-- Form Footer (Buttons) -->
                  <HBox alignment="CENTER_RIGHT" spacing="15.0" style="-fx-background-color: white; -fx-padding: 20 30 30 30; -fx-background-radius: 0 0 12 12;">
                     <children>
                        <Button mnemonicParsing="false" onAction="#handleCloseCreateForm" prefHeight="40.0" prefWidth="120.0" style="-fx-background-color: white; -fx-border-color: #cbd5e1; -fx-border-radius: 6; -fx-text-fill: #475569; -fx-font-weight: bold; -fx-cursor: hand;" text="HỦY BỎ" />
                        <Button mnemonicParsing="false" onAction="#handleSaveCustomer" prefHeight="40.0" prefWidth="160.0" style="-fx-background-color: #0f766e; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand;" text="TẠO HỒ SƠ" />
                     </children>
                  </HBox>
                  
               </children>
            </VBox>
         </children>
      </StackPane>
   </children>
</AnchorPane>